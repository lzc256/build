diff --git a/doc/troubleshooting.md b/doc/troubleshooting.md
index eb35701..057995b 100644
--- a/doc/troubleshooting.md
+++ b/doc/troubleshooting.md
@@ -7,6 +7,37 @@ Whenever anyone from a different API server talks in chat, fallback API server p
 
 ## My game immediately crashed!
 
+If you're getting a crash on Android or a non-standard JVM like this:
+
+```
+#  SIGSEGV (0xb) at pc=0x..., pid=..., tid=...
+# Problematic frame:
+# C  [libinstrument.so+0x...]
+```
+
+then the JVM's instrumentation implementation has crashed. This is a known issue
+with Android-based JVMs (ZalithLauncher2, PojavLauncher, etc.) on aarch64. To work around
+this, add the following JVM argument:
+
+```
+-DLoki.no_retransform=true
+```
+
+This disables retransformation of already-loaded classes and skips
+appendToBootstrapClassLoaderSearch(). The following features will not
+apply to classes that were already loaded before Loki started:
+
+- **Authlib-Injector killer** -- authlib-injector classes already loaded will not be
+  neutralised. Simply do not use authlib-injector on Android.
+- **Forge 1.13-1.16 URL factory fix** -- the LegacyFix agent's URL factory override will
+  not be intercepted. Forge does not run on Android.
+- **DNS blocking** -- `InetAddress` DNS lookups for blocked hosts (OptiFine, snooper) will
+  not be intercepted. Snooper and OptiFine cape blocking are handled by Loki's URL factory,
+  which continues to work.
+
+WebSocket signaling support for Minecraft 26.2+ official multiplayer is **not** affected
+by this option.
+
 If you're getting a crash like this:
 
 ```
diff --git a/src/main/java/org/unmojang/loki/Loki.java b/src/main/java/org/unmojang/loki/Loki.java
index ffc0c25..47d52b5 100644
--- a/src/main/java/org/unmojang/loki/Loki.java
+++ b/src/main/java/org/unmojang/loki/Loki.java
@@ -10,6 +10,7 @@ public class Loki {
 
     public static final Boolean chat_restrictions =  Boolean.getBoolean("Loki.chat_restrictions");
     public static Boolean disable_factory = Boolean.getBoolean("Loki.disable_factory");
+    public static final Boolean no_retransform = Boolean.getBoolean("Loki.no_retransform");
     public static final Boolean disable_profile_lookup = Boolean.getBoolean("Loki.disable_profile_lookup");
     public static final Boolean enable_patchy =  Boolean.getBoolean("Loki.enable_patchy");
     public static final Boolean enable_snooper =  Boolean.getBoolean("Loki.enable_snooper");
@@ -24,12 +25,16 @@ public class Loki {
         LokiUtil.earlyInit(agentArgs, inst);
 
         // Kill Loki alternatives so that Loki won't break
-        LokiUtil.addRetransformTransformer(new LokiAlternativesTransformer(), inst);
-        LokiUtil.retransformClass("moe.yushi.authlibinjector.Premain", inst);
-        LokiUtil.retransformClass("moe.yushi.authlibinjector.javaagent.AuthlibInjectorPremain", inst);
-        LokiUtil.retransformClass("org.to2mbn.authlibinjector.javaagent.AuthlibInjectorPremain", inst);
-        LokiUtil.retransformClass("moe.yushi.authlibinjector.transform.ClassTransformer", inst);
-        LokiUtil.retransformClass("org.to2mbn.authlibinjector.transform.ClassTransformer", inst);
+        if (no_retransform) {
+            inst.addTransformer(new LokiAlternativesTransformer());
+        } else {
+            LokiUtil.addRetransformTransformer(new LokiAlternativesTransformer(), inst);
+            LokiUtil.retransformClass("moe.yushi.authlibinjector.Premain", inst);
+            LokiUtil.retransformClass("moe.yushi.authlibinjector.javaagent.AuthlibInjectorPremain", inst);
+            LokiUtil.retransformClass("org.to2mbn.authlibinjector.javaagent.AuthlibInjectorPremain", inst);
+            LokiUtil.retransformClass("moe.yushi.authlibinjector.transform.ClassTransformer", inst);
+            LokiUtil.retransformClass("org.to2mbn.authlibinjector.transform.ClassTransformer", inst);
+        }
 
         // Authentication & skins/capes
         RequestInterceptor.setURLFactory();
@@ -76,18 +81,32 @@ public class Loki {
         inst.addTransformer(new MCAuthlibGameProfileTransformer()); // Primarily for MojangFix
         inst.addTransformer(new ReIndevGetSkinTransformer()); // Fix a bug in ReIndev's ThreadGetSkin
         inst.addTransformer(new MCOSEMultiplayerTransformer()); // Propagate Loki into MCOSE server subprocess
-        LokiUtil.addRetransformTransformer(new SetURLFactoryTransformer(), inst); // Fix 1.13-1.16 Forge, LegacyFix agent
-        LokiUtil.retransformClass("uk.betacraft.legacyfix.LegacyFixLauncher", inst);
+        if (no_retransform) {
+            inst.addTransformer(new SetURLFactoryTransformer());
+        } else {
+            LokiUtil.addRetransformTransformer(new SetURLFactoryTransformer(), inst); // Fix 1.13-1.16 Forge, LegacyFix agent
+            LokiUtil.retransformClass("uk.betacraft.legacyfix.LegacyFixLauncher", inst);
+        }
         inst.addTransformer(new TitleScreenTransformer()); // Server brand on title screen for 26.1+
 
         // Intercept OptiFine capes to prevent collisions, for whatever reason it isn't caught by Loki's URL factory
         inst.addTransformer(new OptiFineCapeTransformer());
 
         // Block some DNS lookups
-        LokiUtil.addRetransformTransformer(new InetAddressTransformer(), inst);
-        LokiUtil.retransformClass("java.net.InetAddress", inst);
+        if (no_retransform) {
+            inst.addTransformer(new InetAddressTransformer());
+        } else {
+            LokiUtil.addRetransformTransformer(new InetAddressTransformer(), inst);
+            LokiUtil.retransformClass("java.net.InetAddress", inst);
+        }
 
         // Apply 1.21.9+ fixes
         LokiUtil.apply1219Fixes();
+
+        if (no_retransform) {
+            log.warn("Retransformation of already-loaded classes is disabled.");
+            log.warn("Authlib-Injector killer, Forge 1.13-1.16 URL factory fix, and DNS");
+            log.warn("blocking will only apply to classes loaded after this point.");
+        }
     }
 }
diff --git a/src/main/java/org/unmojang/loki/LokiUtil.java b/src/main/java/org/unmojang/loki/LokiUtil.java
index fcbe4cc..7415db4 100644
--- a/src/main/java/org/unmojang/loki/LokiUtil.java
+++ b/src/main/java/org/unmojang/loki/LokiUtil.java
@@ -353,6 +353,7 @@ public class LokiUtil {
     private static void hookFutureClassLoaders(Instrumentation inst, File jarFile) throws Exception {
         final URL jarUrl = jarFile.toURI().toURL();
         final Map<ClassLoader, Boolean> injectedLoaders = new ConcurrentHashMap<ClassLoader, Boolean>();
+        final boolean isNoRetransform = Loki.no_retransform;
         ClassFileTransformer injector = new ClassFileTransformer() {
             public byte[] transform(ClassLoader loader, String name, Class<?> c, ProtectionDomain pd, byte[] bytes) {
                 if (loader == null || injectedLoaders.containsKey(loader)) return null;
@@ -372,7 +373,11 @@ public class LokiUtil {
             }
         };
 
-        addRetransformTransformer(injector, inst);
+        if (isNoRetransform) {
+            inst.addTransformer(injector);
+        } else {
+            addRetransformTransformer(injector, inst);
+        }
     }
 
     private static void pinHookClasses() {
@@ -435,10 +440,14 @@ public class LokiUtil {
             // appending to bootstrap class loader seems to only be necessary on Java 9+ and causes IllegalAccessErrors
             // on Java 8 and below.
             if (JAVA_MAJOR > 8) {
-                try {
-                    Method m = Instrumentation.class.getMethod("appendToBootstrapClassLoaderSearch", JarFile.class);
-                    m.invoke(inst, new JarFile(tmpJar));
-                } catch (NoSuchMethodException ignored) {}
+                if (!Loki.no_retransform) {
+                    try {
+                        Method m = Instrumentation.class.getMethod("appendToBootstrapClassLoaderSearch", JarFile.class);
+                        m.invoke(inst, new JarFile(tmpJar));
+                    } catch (NoSuchMethodException ignored) {}
+                } else {
+                    Loki.log.debug("Skipped appendToBootstrapClassLoaderSearch (no_retransform=true)");
+                }
             }
             hookFutureClassLoaders(inst, tmpJar);
             Loki.log.debug("Appended hooks to classpath");
