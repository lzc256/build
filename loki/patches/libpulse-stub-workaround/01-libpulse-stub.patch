From 80f7fa761b2e9a80a7a8b567f8320b35ec461d14 Mon Sep 17 00:00:00 2001
From: lzc256 <i@lzc256.com>
Date: Tue, 23 Jun 2026 00:35:32 +0800
Subject: [PATCH] Add libpulse.so.0 stub extraction for Android WebRTC compat

---
 src/main/java/org/unmojang/loki/Loki.java     |  7 ++
 src/main/java/org/unmojang/loki/LokiUtil.java | 74 +++++++++++++++++++
 2 files changed, 81 insertions(+)

diff --git a/src/main/java/org/unmojang/loki/Loki.java b/src/main/java/org/unmojang/loki/Loki.java
index 172e062..ad84821 100644
--- a/src/main/java/org/unmojang/loki/Loki.java
+++ b/src/main/java/org/unmojang/loki/Loki.java
@@ -23,6 +23,13 @@ public class Loki {
     public static void premain(String agentArgs, Instrumentation inst) {
         log.info("Hello Loki " + Loki.class.getPackage().getImplementationVersion() + " World!");
         if (android) log.info("[android] Loki.android=true: Android compat mode enabled");
+
+        // Extract and load libpulse.so.0 stub for WebRTC on Android
+        // This must happen before any class that might trigger WebRTC native loading
+        if (android) {
+            LokiUtil.extractPulseAudioStub();
+        }
+
         log.debug("[TRACE] premain: calling earlyInit");
         LokiUtil.earlyInit(agentArgs, inst);
         log.debug("[TRACE] premain: earlyInit returned");
diff --git a/src/main/java/org/unmojang/loki/LokiUtil.java b/src/main/java/org/unmojang/loki/LokiUtil.java
index ec87a08..1e1b9a5 100644
--- a/src/main/java/org/unmojang/loki/LokiUtil.java
+++ b/src/main/java/org/unmojang/loki/LokiUtil.java
@@ -600,4 +600,78 @@ public class LokiUtil {
     public static String getFqmn(String className, String name, String desc) {
         return className.replace('/', '.') + "::" + name + desc;
     }
+
+    /**
+     * Extract and load libpulse.so.0 stub for WebRTC on Android.
+     *
+     * Minecraft 26.2+ P2P uses WebRTC data-channel, which depends on libpulse.so.0
+     * (PulseAudio) at the native library level. Android doesn't have PulseAudio.
+     * This extracts a stub library and loads it so dlopen can find it for DT_NEEDED.
+     *
+     * Strategy:
+     * 1. Extract libpulse.so.0 to java.io.tmpdir (same dir JNA extracts WebRTC natives)
+     * 2. Call System.load() to pre-load it into the linker namespace
+     *    Once loaded, subsequent dlopen calls will find it for DT_NEEDED resolution
+     */
+    public static void extractPulseAudioStub() {
+        try {
+            // Find target directory - same as JNA's native extraction directory
+            String targetDir = System.getProperty("jna.tmpdir");
+            if (targetDir == null) {
+                targetDir = System.getProperty("java.io.tmpdir");
+            }
+            if (targetDir == null) {
+                targetDir = System.getenv("TMPDIR");
+            }
+
+            if (targetDir == null) {
+                Loki.log.warn("[android] Could not find temp directory for libpulse.so.0 stub");
+                return;
+            }
+
+            File targetFile = new File(targetDir, "libpulse.so.0");
+            if (!targetFile.exists()) {
+                // Extract from JAR resources
+                InputStream is = LokiUtil.class.getResourceAsStream("/libpulse_stub/linux-aarch64/libpulse.so.0");
+                if (is == null) {
+                    Loki.log.warn("[android] libpulse.so.0 stub not found in JAR resources");
+                    return;
+                }
+
+                try {
+                    OutputStream os = new FileOutputStream(targetFile);
+                    try {
+                        byte[] buf = new byte[8192];
+                        int read;
+                        while ((read = is.read(buf)) != -1) {
+                            os.write(buf, 0, read);
+                        }
+                    } finally {
+                        os.close();
+                    }
+                } finally {
+                    is.close();
+                }
+
+                // Set executable permission
+                targetFile.setExecutable(true, false);
+                targetFile.setReadable(true, false);
+
+                Loki.log.info("[android] Extracted libpulse.so.0 stub to " + targetFile.getAbsolutePath());
+            } else {
+                Loki.log.debug("[android] libpulse.so.0 stub already exists at " + targetFile.getAbsolutePath());
+            }
+
+            // Load the stub into the process's linker namespace.
+            // This ensures it's available for DT_NEEDED resolution when WebRTC natives are dlopen'd later.
+            try {
+                System.load(targetFile.getAbsolutePath());
+                Loki.log.info("[android] Successfully loaded libpulse.so.0 stub into linker namespace");
+            } catch (UnsatisfiedLinkError e) {
+                Loki.log.warn("[android] Failed to load libpulse.so.0 stub (architecture mismatch or SELinux)", e);
+            }
+        } catch (Exception e) {
+            Loki.log.warn("[android] Failed to extract libpulse.so.0 stub", e);
+        }
+    }
 }
-- 
