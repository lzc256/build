     public static void premain(String agentArgs, Instrumentation inst) {
         log.info("Hello Loki " + Loki.class.getPackage().getImplementationVersion() + " World!");
         if (android) log.info("[android] Loki.android=true: Android compat mode enabled");
+
+        // Extract and load native stubs for WebRTC on Android
+        // libwebrtc-java-linux-aarch64.so has DT_NEEDED for libpulse.so.0, libudev.so.1, libX11.so.6, libXfixes.so.3,
+        // libXrandr.so.2, libXcursor.so.1, libXcomposite.so.1, libXdamage.so.1
+        // which don't exist on Android. These stubs satisfy the linker so data-channel works.
+        if (android) {
+            LokiUtil.extractNativeStubs();
+        }
