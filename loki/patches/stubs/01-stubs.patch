diff --git a/src/main/java/org/unmojang/loki/Loki.java b/src/main/java/org/unmojang/loki/Loki.java
index 172e062..1099ffe 100644
--- a/src/main/java/org/unmojang/loki/Loki.java
+++ b/src/main/java/org/unmojang/loki/Loki.java
@@ -23,6 +23,14 @@ public class Loki {
     public static void premain(String agentArgs, Instrumentation inst) {
         log.info("Hello Loki " + Loki.class.getPackage().getImplementationVersion() + " World!");
         if (android) log.info("[android] Loki.android=true: Android compat mode enabled");
+
+        // Extract and load native stubs for WebRTC on Android
+        // libwebrtc-java-linux-aarch64.so has DT_NEEDED for libpulse.so.0, libudev.so.1, libX11.so.6, libXfixes.so.3,
+        // libXrandr.so.2, libXcursor.so.1, libXcomposite.so.1, libXdamage.so.1, libdbus-1.so.3, libstdc++.so.6, libm.so.6
+        // which don't exist on Android. These stubs satisfy the linker so data-channel works.
+        if (android) {
+            LokiUtil.extractNativeStubs();
+        }
         log.debug("[TRACE] premain: calling earlyInit");
         LokiUtil.earlyInit(agentArgs, inst);
         log.debug("[TRACE] premain: earlyInit returned");
diff --git a/src/main/java/org/unmojang/loki/LokiUtil.java b/src/main/java/org/unmojang/loki/LokiUtil.java
index ec87a08..36766ac 100644
--- a/src/main/java/org/unmojang/loki/LokiUtil.java
+++ b/src/main/java/org/unmojang/loki/LokiUtil.java
@@ -600,4 +600,104 @@ public class LokiUtil {
     public static String getFqmn(String className, String name, String desc) {
         return className.replace('/', '.') + "::" + name + desc;
     }
+
+    /**
+     * Extract and load native stub libraries for WebRTC on Android.
+     *
+     * Minecraft 26.2+ P2P uses WebRTC data-channel, which depends on
+     * libpulse.so.0 (PulseAudio), libudev.so.1, libX11.so.6, libXfixes.so.3,
+     * libXrandr.so.2, libXcursor.so.1, libXcomposite.so.1, libXdamage.so.1, libdbus-1.so.3, libstdc++.so.6, libm.so.6
+     * at the native library level.
+     * Android doesn't have these. This extracts stub libraries and loads them
+     * so dlopen can find them for DT_NEEDED resolution.
+     *
+     * Stubs go to a dedicated loki_jna_stubs directory (sibling to JNA's tmpdir)
+     * and are always extracted fresh on startup.
+     * System.load() pre-loads them into the linker namespace.
+     */
+    public static void extractNativeStubs() {
+        String baseDir = System.getProperty("jna.tmpdir");
+        if (baseDir == null) {
+            baseDir = System.getProperty("java.io.tmpdir");
+        }
+        if (baseDir == null) {
+            baseDir = System.getenv("TMPDIR");
+        }
+        if (baseDir == null) {
+            Loki.log.warn("[android] Could not find temp directory for native stubs");
+            return;
+        }
+
+        // Use dedicated directory for Loki stubs, clear it on startup
+        File stubDir = new File(baseDir, "loki_jna_stubs");
+        if (stubDir.exists()) {
+            // Clear old stubs to ensure we always have the latest version
+            File[] oldFiles = stubDir.listFiles();
+            if (oldFiles != null) {
+                for (File f : oldFiles) {
+                    f.delete();
+                }
+            }
+        } else {
+            stubDir.mkdirs();
+        }
+
+        String[] stubs = {
+            "/libpulse_stub/linux-aarch64/libpulse.so.0",
+            "/libudev_stub/linux-aarch64/libudev.so.1",
+            "/libX11_stub/linux-aarch64/libX11.so.6",
+            "/libXfixes_stub/linux-aarch64/libXfixes.so.3",
+            "/libXrandr_stub/linux-aarch64/libXrandr.so.2",
+            "/libXcursor_stub/linux-aarch64/libXcursor.so.1",
+            "/libXcomposite_stub/linux-aarch64/libXcomposite.so.1",
+            "/libXdamage_stub/linux-aarch64/libXdamage.so.1",
+            "/libdbus-1_stub/linux-aarch64/libdbus-1.so.3",
+            "/libstdc++_stub/linux-aarch64/libstdc++.so.6",
+            "/libm_stub/linux-aarch64/libm.so.6"
+        };
+
+        for (String stubPath : stubs) {
+            try {
+                File targetFile = new File(stubDir, new File(stubPath).getName());
+                String libName = targetFile.getName();
+
+                // Extract fresh stub
+                InputStream is = LokiUtil.class.getResourceAsStream(stubPath);
+                if (is == null) {
+                    Loki.log.warn("[android] " + libName + " stub not found in JAR resources");
+                    continue;
+                }
+
+                try {
+                    OutputStream os = new FileOutputStream(targetFile);
+                    try {
+                        byte[] buf = new byte[8192];
+                        int read;
+                        while ((read = is.read(buf)) != -1) {
+                            os.write(buf, 0, read);
+                        }
+                    } finally {
+                        os.close();
+                    }
+                } finally {
+                    is.close();
+                }
+
+                targetFile.setExecutable(true, false);
+                targetFile.setReadable(true, false);
+
+                Loki.log.debug("[android] Extracted " + libName + " stub to " + targetFile.getAbsolutePath());
+
+                // Load the stub into the process's linker namespace.
+                // Once loaded, subsequent dlopen calls will find it for DT_NEEDED resolution.
+                try {
+                    System.load(targetFile.getAbsolutePath());
+                    Loki.log.info("[android] Successfully loaded " + libName + " stub into linker namespace");
+                } catch (UnsatisfiedLinkError e) {
+                    Loki.log.warn("[android] Failed to load " + libName + " stub (architecture mismatch or SELinux)", e);
+                }
+            } catch (Exception e) {
+                Loki.log.warn("[android] Failed to extract " + stubPath, e);
+            }
+        }
+    }
 }
