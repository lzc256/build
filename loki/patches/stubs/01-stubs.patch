@@ -582,4 +600,93 @@ public class LokiUtil {
     public static String getFqmn(String className, String name, String desc) {
         return className.replace('/', '.') + "::" + name + desc;
     }
+
+    /**
+     * Extract and load native stub libraries for WebRTC on Android.
+     *
+     * Minecraft 26.2+ P2P uses WebRTC data-channel, which depends on
+     * libpulse.so.0 (PulseAudio), libudev.so.1, libX11.so.6, libXfixes.so.3,
+     * libXrandr.so.2, libXcursor.so.1, libXcomposite.so.1, libXdamage.so.1, libdbus-1.so.3, libstdc++.so.6
+     * at the native library level.
+     * Android doesn't have these. This extracts stub libraries and loads them
+     * so dlopen can find them for DT_NEEDED resolution.
+     *
+     * Stubs go to jna.tmpdir (same dir JNA extracts WebRTC natives)
+     * so the linker can find them alongside the loading library.
+     * System.load() also pre-loads them into the linker namespace.
+     */
+    public static void extractNativeStubs() {
+        String targetDir = System.getProperty("jna.tmpdir");
+        if (targetDir == null) {
+            targetDir = System.getProperty("java.io.tmpdir");
+        }
+        if (targetDir == null) {
+            targetDir = System.getenv("TMPDIR");
+        }
+        if (targetDir == null) {
+            Loki.log.warn("[android] Could not find temp directory for native stubs");
+            return;
+        }
+
+        String[] stubs = {
+            "/libpulse_stub/linux-aarch64/libpulse.so.0",
+            "/libudev_stub/linux-aarch64/libudev.so.1",
+            "/libX11_stub/linux-aarch64/libX11.so.6",
+            "/libXfixes_stub/linux-aarch64/libXfixes.so.3",
+            "/libXrandr_stub/linux-aarch64/libXrandr.so.2",
+            "/libXcursor_stub/linux-aarch64/libXcursor.so.1",
+            "/libXcomposite_stub/linux-aarch64/libXcomposite.so.1",
+            "/libXdamage_stub/linux-aarch64/libXdamage.so.1",
+            "/libdbus-1_stub/linux-aarch64/libdbus-1.so.3",
+            "/libstdc++_stub/linux-aarch64/libstdc++.so.6"
+        };
+
+        for (String stubPath : stubs) {
+            try {
+                File targetFile = new File(targetDir, new File(stubPath).getName());
+                String libName = targetFile.getName();
+
+                if (!targetFile.exists()) {
+                    InputStream is = LokiUtil.class.getResourceAsStream(stubPath);
+                    if (is == null) {
+                        Loki.log.warn("[android] " + libName + " stub not found in JAR resources");
+                        continue;
+                    }
+
+                    try {
+                        OutputStream os = new FileOutputStream(targetFile);
+                        try {
+                            byte[] buf = new byte[8192];
+                            int read;
+                            while ((read = is.read(buf)) != -1) {
+                                os.write(buf, 0, read);
+                            }
+                        } finally {
+                            os.close();
+                        }
+                    } finally {
+                        is.close();
+                    }
+
+                    targetFile.setExecutable(true, false);
+                    targetFile.setReadable(true, false);
+
+                    Loki.log.info("[android] Extracted " + libName + " stub to " + targetFile.getAbsolutePath());
+                } else {
+                    Loki.log.debug("[android] " + libName + " stub already exists at " + targetFile.getAbsolutePath());
+                }
+
+                // Load the stub into the process's linker namespace.
+                // Once loaded, subsequent dlopen calls will find it for DT_NEEDED resolution.
+                try {
+                    System.load(targetFile.getAbsolutePath());
+                    Loki.log.info("[android] Successfully loaded " + libName + " stub into linker namespace");
+                } catch (UnsatisfiedLinkError e) {
+                    Loki.log.warn("[android] Failed to load " + libName + " stub (architecture mismatch or SELinux)", e);
+                }
+            } catch (Exception e) {
+                Loki.log.warn("[android] Failed to extract " + stubPath, e);
+            }
+        }
+    }
 }
