From ba4e0f865f72a4cb3d9fad5952e0a75aa2f09e58 Mon Sep 17 00:00:00 2001
From: lzc256 <i@lzc256.com>
Date: Mon, 22 Jun 2026 17:17:26 +0800
Subject: [PATCH] Add no_bootstrap_append option to skip
 appendToBootstrapClassLoaderSearch

---
 src/main/java/org/unmojang/loki/LokiUtil.java | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/src/main/java/org/unmojang/loki/LokiUtil.java b/src/main/java/org/unmojang/loki/LokiUtil.java
index fcbe4cc..079ff50 100644
--- a/src/main/java/org/unmojang/loki/LokiUtil.java
+++ b/src/main/java/org/unmojang/loki/LokiUtil.java
@@ -434,11 +434,19 @@ public class LokiUtil {
 
             // appending to bootstrap class loader seems to only be necessary on Java 9+ and causes IllegalAccessErrors
             // on Java 8 and below.
+            // Some JVMs (notably Android OpenJDK on aarch64) crash with SIGSEGV in libinstrument.so
+            // when appendToBootstrapClassLoaderSearch is called. Skip it when the
+            // Loki.no_bootstrap_append system property is set; hookFutureClassLoaders
+            // provides an alternative mechanism for injecting hook classes.
             if (JAVA_MAJOR > 8) {
-                try {
-                    Method m = Instrumentation.class.getMethod("appendToBootstrapClassLoaderSearch", JarFile.class);
-                    m.invoke(inst, new JarFile(tmpJar));
-                } catch (NoSuchMethodException ignored) {}
+                if (!Boolean.getBoolean("Loki.no_bootstrap_append")) {
+                    try {
+                        Method m = Instrumentation.class.getMethod("appendToBootstrapClassLoaderSearch", JarFile.class);
+                        m.invoke(inst, new JarFile(tmpJar));
+                    } catch (NoSuchMethodException ignored) {}
+                } else {
+                    Loki.log.debug("Skipped appendToBootstrapClassLoaderSearch (no_bootstrap_append=true)");
+                }
             }
             hookFutureClassLoaders(inst, tmpJar);
             Loki.log.debug("Appended hooks to classpath");
-- 
