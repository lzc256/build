From 9c53525ad148df3619bbe5ea984e9800ae8d32d0 Mon Sep 17 00:00:00 2001
From: lzc256 <lzc256@users.noreply.github.com>
Date: Wed, 28 Oct 2026 19:08:08 +0800
Subject: [PATCH] Rename applicationId for fcitx5-sync coexistence build

- app: org.fcitx.fcitx5.android -> org.fcitx.fcitx5.android.sync
  (installable side-by-side with the official app)
- build-logic: plugin MAIN_APPLICATION_ID / manifest placeholders follow
- PluginDescriptor.pluginPackagePrefix -> ...sync.plugin. (plugin
  packages no longer collide with officially installed ones)
- plugin/rime applicationId -> org.fcitx.fcitx5.android.sync.plugin.rime
---
 app/build.gradle.kts                                          | 2 +-
 .../org/fcitx/fcitx5/android/core/data/PluginDescriptor.kt    | 2 +-
 .../src/main/kotlin/AndroidPluginAppConventionPlugin.kt       | 4 ++--
 plugin/rime/build.gradle.kts                                  | 2 +-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 53f1eb8c..ad9c50fb 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -13,7 +13,7 @@ android {
     namespace = "org.fcitx.fcitx5.android"
 
     defaultConfig {
-        applicationId = "org.fcitx.fcitx5.android"
+        applicationId = "org.fcitx.fcitx5.android.sync"
         testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
 
         @Suppress("UnstableApiUsage")
diff --git a/app/src/main/java/org/fcitx/fcitx5/android/core/data/PluginDescriptor.kt b/app/src/main/java/org/fcitx/fcitx5/android/core/data/PluginDescriptor.kt
index cec9078e..ae90f86b 100644
--- a/app/src/main/java/org/fcitx/fcitx5/android/core/data/PluginDescriptor.kt
+++ b/app/src/main/java/org/fcitx/fcitx5/android/core/data/PluginDescriptor.kt
@@ -37,7 +37,7 @@ data class PluginDescriptor(
     val name = packageName.removePrefix(pluginPackagePrefix).removeSuffix(pluginPackageSuffix)
 
     companion object {
-        const val pluginPackagePrefix = "org.fcitx.fcitx5.android.plugin."
+        const val pluginPackagePrefix = "org.fcitx.fcitx5.android.sync.plugin."
         const val pluginPackageSuffix = ".${BuildConfig.BUILD_TYPE}"
         const val pluginAPI = "0.1"
     }
diff --git a/build-logic/convention/src/main/kotlin/AndroidPluginAppConventionPlugin.kt b/build-logic/convention/src/main/kotlin/AndroidPluginAppConventionPlugin.kt
index 8a19dd27..e955dc51 100644
--- a/build-logic/convention/src/main/kotlin/AndroidPluginAppConventionPlugin.kt
+++ b/build-logic/convention/src/main/kotlin/AndroidPluginAppConventionPlugin.kt
@@ -24,7 +24,7 @@ class AndroidPluginAppConventionPlugin : Plugin<Project> {
                     buildConfigField("String", "MAIN_APPLICATION_ID", "\"org.fcitx.fcitx5.android\"")
                     addManifestPlaceholders(
                         mapOf(
-                            "mainApplicationId" to "org.fcitx.fcitx5.android",
+                            "mainApplicationId" to "org.fcitx.fcitx5.android.sync",
                         )
                     )
                 }
@@ -32,7 +32,7 @@ class AndroidPluginAppConventionPlugin : Plugin<Project> {
                     buildConfigField("String", "MAIN_APPLICATION_ID", "\"org.fcitx.fcitx5.android.debug\"")
                     addManifestPlaceholders(
                         mapOf(
-                            "mainApplicationId" to "org.fcitx.fcitx5.android.debug",
+                            "mainApplicationId" to "org.fcitx.fcitx5.android.sync.debug",
                         )
                     )
                 }
diff --git a/plugin/rime/build.gradle.kts b/plugin/rime/build.gradle.kts
index 1733282c..a03cf412 100644
--- a/plugin/rime/build.gradle.kts
+++ b/plugin/rime/build.gradle.kts
@@ -11,7 +11,7 @@ android {
     namespace = "org.fcitx.fcitx5.android.plugin.rime"
 
     defaultConfig {
-        applicationId = "org.fcitx.fcitx5.android.plugin.rime"
+        applicationId = "org.fcitx.fcitx5.android.sync.plugin.rime"
 
         @Suppress("UnstableApiUsage")
         externalNativeBuild {
-- 
2.56.0

