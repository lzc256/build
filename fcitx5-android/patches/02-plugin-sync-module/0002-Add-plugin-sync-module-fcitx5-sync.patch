+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 fcitx5-sync contributors
+ */
+package org.fcitx.fcitx5.android.plugin.sync
+
+import android.content.Context
+import android.content.SharedPreferences
+
+/** 插件配置，存本 App 的 SharedPreferences。 */
+object Settings {
+    private const val PREFS = "sync_settings"
+
+    private lateinit var prefs: SharedPreferences
+
+    fun init(context: Context) {
+        if (!::prefs.isInitialized) {
+            prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        }
+    }
+
+    /** 服务器地址，如 https://sync.example.com */
+    var server: String
+        get() = prefs.getString("server", null)?.trim()?.trimEnd('/') ?: ""
+        set(value) = prefs.edit().putString("server", value).apply()
+
+    /** 设备 id，须与主程序 rime installation.yaml 的 installation_id 一致 */
+    var deviceId: String
+        get() = prefs.getString("device_id", null)?.trim() ?: ""
+        set(value) = prefs.edit().putString("device_id", value).apply()
+
+    /** 设备 bearer token（服务器 POST /v1/devices 签发） */
+    var token: String
+        get() = prefs.getString("token", null)?.trim() ?: ""
+        set(value) = prefs.edit().putString("token", value).apply()
+
+    /** 轮询间隔（秒） */
+    var intervalSeconds: Int
+        get() = prefs.getInt("interval_seconds", 30).coerceAtLeast(5)
+        set(value) = prefs.edit().putInt("interval_seconds", value).apply()
+
+    /** Rime 数据目录覆盖（默认按主程序包名推导） */
+    var rimeDirOverride: String
+        get() = prefs.getString("rime_dir_override", null)?.trim()?.trimEnd('/') ?: ""
+        set(value) = prefs.edit().putString("rime_dir_override", value).apply()
+
+    val configured: Boolean
+        get() = server.isNotBlank() && deviceId.isNotBlank() && token.isNotBlank()
+}
diff --git a/plugin/sync/src/main/java/org/fcitx/fcitx5/android/plugin/sync/SyncService.kt b/plugin/sync/src/main/java/org/fcitx/fcitx5/android/plugin/sync/SyncService.kt
new file mode 100644
index 00000000..8d6157da
--- /dev/null
+++ b/plugin/sync/src/main/java/org/fcitx/fcitx5/android/plugin/sync/SyncService.kt
@@ -0,0 +1,192 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 fcitx5-sync contributors
+ */
+package org.fcitx.fcitx5.android.plugin.sync
+
+import android.util.Log
+import org.fcitx.fcitx5.android.common.FcitxPluginService
+import org.fcitx.fcitx5.android.common.ipc.FcitxRemoteConnection
+import org.fcitx.fcitx5.android.common.ipc.IFcitxRemoteService
+import org.fcitx.fcitx5.android.common.ipc.bindFcitxRemoteService
+import kotlinx.coroutines.CoroutineName
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import syncclient.Syncclient
+import java.io.File
+
+/**
+ * fcitx5-sync 的 Android 端同步服务。
+ *
+ * 同步循环（每 interval 秒）：
+ *  1. AIDL 调 triggerRimeSync() —— 主程序内 fcitx5-rime 执行 RIME 同步，
+ *     把本地 userdb 导出为 sync/<id> 下的 *.userdb.txt 快照
+ *  2. 上传这些快照到中心服务器（Go 共享核心 syncclient）
+ *  3. 轮询 hub 版本，有更新则下载到 sync/hub/
+ *  4. 再次 triggerRimeSync() —— 引擎把 hub/（视为另一台"设备"）合并进本地 userdb
+ */
+class SyncService : FcitxPluginService() {
+
+    private var scope: CoroutineScope? = null
+    private var connection: FcitxRemoteConnection? = null
+
+    override fun start() {
+        Settings.init(this)
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO + CoroutineName("fcitx5-sync"))
+        this.scope = scope
+
+        if (!Settings.configured) {
+            log("Not configured (server/device/token). Open ${BuildConfig.APPLICATION_ID} to configure.")
+            return
+        }
+
+        connection = bindFcitxRemoteService(BuildConfig.MAIN_APPLICATION_ID) { remote ->
+            log("Bound to fcitx remote, starting sync loop")
+            scope.launch {
+                syncLoop(remote)
+            }
+        }
+    }
+
+    override fun stop() {
+        log("Stopping sync loop")
+        scope?.cancel()
+        scope = null
+        connection?.let {
+            runCatching { unbindService(it) }
+        }
+        connection = null
+    }
+
+    private suspend fun syncLoop(remote: IFcitxRemoteService) {
+        val client = Syncclient.newClient(Settings.server, Settings.deviceId, Settings.token)
+        val state = getSharedPreferences("sync_state", MODE_PRIVATE)
+        while (scope?.isActive == true) {
+            try {
+                cycle(remote, client, state)
+            } catch (t: Throwable) {
+                log("Cycle failed: ${t.message}")
+            }
+            delay(Settings.intervalSeconds * 1000L)
+        }
+    }
+
+    private suspend fun cycle(
+        remote: IFcitxRemoteService,
+        client: Syncclient,
+        state: android.content.SharedPreferences,
+    ) {
+        val syncDir = rimeSyncDir()
+
+        // 1. 触发引擎同步（导出快照 + 合并 sync/hub/）
+        triggerEngineSync(remote, state)
+
+        // 2. 上传 sync/<device> 下的 userdb 快照
+        val deviceDir = File(syncDir, Settings.deviceId)
+        deviceDir.listFiles { f -> f.isFile && f.name.endsWith(".userdb.txt") }
+            ?.forEach { file ->
+                val db = file.name.removeSuffix(".userdb.txt")
+                val data = file.readBytes()
+                if (client.validateSnapshot(data) == null) {
+                    val v = client.uploadSnapshot(db, data)
+                    log("Uploaded $db -> hub v$v")
+                } else {
+                    log("Skip invalid snapshot $db")
+                }
+            }
+
+        // 3. 拉 hub 更新
+        var changed = false
+        for (db in client.hubDBs()) {
+            val v = client.hubVersion(db)
+            if (state.getLong("hub_$db", 0L) >= v) continue
+            val data = client.downloadHub(db)
+            val hubDir = File(syncDir, "hub")
+            hubDir.mkdirs()
+            val dst = File(hubDir, "$db.userdb.txt")
+            val tmp = File(hubDir, "$db.userdb.txt.tmp")
+            tmp.writeBytes(data)
+            if (!tmp.renameTo(dst)) {
+                log("Failed to rename hub tmp for $db")
+                continue
+            }
+            state.edit().putLong("hub_$db", v).apply()
+            changed = true
+            log("Hub/$db updated to v$v")
+        }
+
+        // 4. 导入：引擎把 sync/hub/（视为另一台"设备"）合并进本地 userdb
+        if (changed) {
+            triggerEngineSync(remote, state)
+            log("Hub merged into local userdb")
+        }
+    }
+
+    /**
+     * 触发 RIME 引擎同步（导出 userdb 快照 + 合并 sync/hub/）。
+     *
+     * 两种模式，自动协商：
+     *  - trigger 模式：主程序打过 triggerRimeSync() 补丁（fcitx5-sync fork），
+     *    精确调用 fcitx5-rime 的 sync 子配置，无副作用 —— 首选
+     *  - restart 模式：主程序是重签名的上游原版（未打补丁），
+     *    降级用 restartFcitx()：fcitx5 退出时 RimeEngine::save() → sync(false)，
+     *    同样完成导出+合并，但会短暂重启输入法引擎 —— 兜底
+     *
+     * 协商结果缓存在 SharedPreferences，每个周期只探测一次。
+     */
+    private suspend fun triggerEngineSync(
+        remote: IFcitxRemoteService,
+        state: android.content.SharedPreferences,
+    ) {
+        val mode = state.getString(KEY_TRIGGER_MODE, TRIGGER_MODE_TRY)
+        if (mode != TRIGGER_MODE_RESTART) {
+            try {
+                remote.triggerRimeSync()
+                if (mode != TRIGGER_MODE_TRIGGER) {
+                    state.edit().putString(KEY_TRIGGER_MODE, TRIGGER_MODE_TRIGGER).apply()
+                    log("Trigger mode: triggerRimeSync (patched main app)")
+                }
+                return
+            } catch (t: Throwable) {
+                // 主程序未实现该 AIDL 事务（原版 APK）→ 降级并缓存
+                log("triggerRimeSync unsupported (${t.javaClass.simpleName}), falling back to restartFcitx")
+                state.edit().putString(KEY_TRIGGER_MODE, TRIGGER_MODE_RESTART).apply()
+            }
+        }
+        // restart 模式：重启 fcitx 引擎以触发 save+sync
+        remote.restartFcitx()
+        // 引擎重启需要时间，等它起来再继续（下一循环的文件读取才完整）
+        delay(3000)
+    }
+
+    /**
+     * Rime 用户数据目录（含 sync/）。
+     * 默认 <外部存储>/Android/data/<主程序包名>/files/data/rime，
+     * 需要所有文件访问权限（MainActivity 里授权）才能跨应用读取。
+     */
+    private fun rimeSyncDir(): File {
+        Settings.rimeDirOverride.takeIf { it.isNotBlank() }?.let {
+            return File(it, "sync")
+        }
+        val ext = android.os.Environment.getExternalStorageDirectory()
+        return File(ext, "Android/data/${BuildConfig.MAIN_APPLICATION_ID}/files/data/rime/sync")
+    }
+
+    private fun log(msg: String) {
+        Log.d(TAG, msg)
+    }
+
+    companion object {
+        private const val TAG = "fcitx5-sync"
+
+        private const val KEY_TRIGGER_MODE = "trigger_mode"
+        private const val TRIGGER_MODE_TRY = "try"
+        private const val TRIGGER_MODE_TRIGGER = "trigger"
+        private const val TRIGGER_MODE_RESTART = "restart"
+    }
+}
diff --git a/plugin/sync/src/main/res/values-zh-rCN/strings.xml b/plugin/sync/src/main/res/values-zh-rCN/strings.xml
