+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="settings_title">同步设置</string>
+    <string name="server_url">服务器地址</string>
+    <string name="server_url_hint">https://sync.example.com</string>
+    <string name="device_id">设备 ID</string>
+    <string name="device_id_hint">须与 installation.yaml 的 installation_id 一致</string>
