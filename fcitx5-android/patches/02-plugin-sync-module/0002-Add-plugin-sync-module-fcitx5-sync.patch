@@ -0,0 +1,140 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 fcitx5-sync contributors
+ */
+package org.fcitx.fcitx5.android.plugin.sync
+
+import android.Manifest
+import android.app.Activity
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import android.os.Bundle
+import android.os.Environment
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.TextView
+import android.widget.Toast
+
+/**
+ * 极简配置界面：服务器 / 设备 ID / Token / 间隔 + 所有文件访问权限申请。
+ * 有意不引入 PreferenceX 依赖，保持插件体积与依赖面最小。
+ */
+class MainActivity : Activity() {
+
+    private lateinit var serverInput: EditText
+    private lateinit var deviceInput: EditText
+    private lateinit var tokenInput: EditText
+    private lateinit var intervalInput: EditText
+    private lateinit var rimeDirInput: EditText
+    private lateinit var storageStatus: TextView
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        Settings.init(this)
+
+        val dp = (resources.displayMetrics.density * 8).toInt()
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp * 2, dp * 2, dp * 2, dp * 2)
+        }
+
+        fun label(textRes: Int): TextView =
+            TextView(this@MainActivity).apply { setText(textRes) }
+
+        fun input(hintRes: Int, isPassword: Boolean = false): EditText =
+            EditText(this@MainActivity).apply {
+                setHint(hintRes)
+                setInputType(
+                    android.text.InputType.TYPE_CLASS_TEXT or
+                        if (isPassword) android.text.InputType.TYPE_TEXT_VARIATION_PASSWORD
+                        else android.text.InputType.TYPE_TEXT_VARIATION_NORMAL
+                )
+            }
+
+        root.addView(label(R.string.server_url))
+        serverInput = input(R.string.server_url_hint)
+        root.addView(serverInput)
+
+        root.addView(label(R.string.device_id))
+        deviceInput = input(R.string.device_id_hint)
+        root.addView(deviceInput)
+
+        root.addView(label(R.string.device_token))
+        tokenInput = input(R.string.device_token, isPassword = true)
+        root.addView(tokenInput)
+
+        root.addView(label(R.string.interval))
+        intervalInput = EditText(this).apply {
+            setHint("30")
+            inputType = android.text.InputType.TYPE_CLASS_NUMBER
+        }
+        root.addView(intervalInput)
+
+        root.addView(label(R.string.rime_dir))
+        rimeDirInput = input(R.string.rime_dir_hint)
+        root.addView(rimeDirInput)
+
+        val save = Button(this).apply { setText(R.string.save) }
+        root.addView(save)
+
+        storageStatus = TextView(this)
+        root.addView(storageStatus)
+
+        val grant = Button(this).apply { setText(R.string.grant_storage) }
+        grant.setOnClickListener { requestAllFilesAccess() }
+        root.addView(grant)
+
+        setContentView(root)
+
+        serverInput.setText(Settings.server)
+        deviceInput.setText(Settings.deviceId)
+        tokenInput.setText(Settings.token)
+        intervalInput.setText(Settings.intervalSeconds.toString())
+        rimeDirInput.setText(Settings.rimeDirOverride)
+        refreshStorageStatus()
+
+        save.setOnClickListener {
+            Settings.server = serverInput.text.toString()
+            Settings.deviceId = deviceInput.text.toString()
+            Settings.token = tokenInput.text.toString()
+            Settings.intervalSeconds = intervalInput.text.toString().toIntOrNull() ?: 30
+            Settings.rimeDirOverride = rimeDirInput.text.toString()
+            Toast.makeText(this, R.string.saved, Toast.LENGTH_SHORT).show()
+        }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        refreshStorageStatus()
+    }
+
+    private fun refreshStorageStatus() {
+        storageStatus.setText(
+            if (hasAllFilesAccess()) R.string.storage_granted else R.string.storage_needed
+        )
+    }
+
+    private fun hasAllFilesAccess(): Boolean =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            Environment.isExternalStorageManager()
+        } else {
+            checkSelfPermission(Manifest.permission.WRITE_EXTERNAL_STORAGE) ==
+                PackageManager.PERMISSION_GRANTED
+        }
+
+    private fun requestAllFilesAccess() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            startActivity(
+                Intent(
+                    android.provider.Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION,
+                    Uri.parse("package:$packageName")
+                )
+            )
+        } else {
+            requestPermissions(arrayOf(Manifest.permission.WRITE_EXTERNAL_STORAGE), 1)
+        }
+    }
+}
