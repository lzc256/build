diff --git a/plugin/sync/build.gradle.kts b/plugin/sync/build.gradle.kts
new file mode 100644
index 00000000..9864c721
--- /dev/null
+++ b/plugin/sync/build.gradle.kts
@@ -0,0 +1,70 @@
+import org.jetbrains.kotlin.gradle.tasks.KotlinCompile
+
+plugins {
+    id("org.fcitx.fcitx5.android.app-convention")
+    id("org.fcitx.fcitx5.android.plugin-app-convention")
+    id("org.fcitx.fcitx5.android.build-metadata")
+    id("org.fcitx.fcitx5.android.data-descriptor")
+}
+
+android {
+    namespace = "org.fcitx.fcitx5.android.plugin.sync"
+
+    defaultConfig {
+        applicationId = "org.fcitx.fcitx5.android.sync.plugin.sync"
+    }
+
+    buildFeatures {
+        resValues = true
+    }
+
+    buildTypes {
+        release {
+            resValue("string", "app_name", "@string/app_name_release")
+            proguardFile("proguard-rules.pro")
+        }
+        debug {
+            resValue("string", "app_name", "@string/app_name_debug")
+        }
+    }
+}
+
+// ---- Go 共享核心（gomobile bind）----
+//
+// fcitx5-sync 的协议客户端核心是 Go 库（github.com/lzc256/fcitx5-sync/core/syncclient），
+// mac-agent / 未来 iOS、桌面客户端与 Android 共用同一份代码。
+// 此任务用 gomobile 把它编译成 AAR；核心源码目录由 FCITX5_SYNC_CORE_DIR 指定
+// （CI 中与 fork 同级 checkout，默认假设 ../fcitx5-sync/core）。
+val coreDir: String = providers.environmentVariable("FCITX5_SYNC_CORE_DIR")
+    .orElse(providers.gradleProperty("fcitx5SyncCoreDir"))
+    .orElse(File(rootDir.parentFile, "fcitx5-sync/core").absolutePath)
+    .get()
+
+val coreAar = file("libs/fcitx5-sync-core.aar")
+
+val buildGoCore by tasks.registering(Exec::class) {
+    group = "build"
+    description = "gomobile bind fcitx5-sync core -> AAR"
+    inputs.dir(File(coreDir))
+    outputs.file(coreAar)
+    workingDir(File(coreDir)) // 让 gomobile/go 从 core 模块解析 go.mod
+    doFirst {
+        coreAar.parentFile.mkdirs()
+    }
+    commandLine(
+        "gomobile", "bind",
+        "-target=android",
+        "-androidapi", "23",
+        "-o", coreAar.absolutePath,
+        "./syncclient",
+    )
+}
+
+tasks.named("preBuild") {
+    dependsOn(buildGoCore)
+}
+
+dependencies {
+    implementation(project(":lib:plugin-base"))
+    implementation(files(coreAar))
+}
