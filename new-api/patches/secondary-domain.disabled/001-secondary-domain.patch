diff --git a/setting/system_setting/primary_origin.go b/setting/system_setting/primary_origin.go
new file mode 100644
index 000000000..f3393cd7c
--- /dev/null
+++ b/setting/system_setting/primary_origin.go
@@ -0,0 +1,42 @@
+package system_setting
+
+import (
+	"net/http"
+	"net/url"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+// PrimaryOrigin returns the normalized origin of ServerAddress, the canonical
+// address of this site. ServerAddress may carry a path prefix (an upstream
+// proxy mount point); the path is dropped because a browser origin never has
+// one.
+func PrimaryOrigin() (string, bool) {
+	parsed, err := url.Parse(strings.TrimSpace(ServerAddress))
+	if err != nil || parsed.Host == "" {
+		return "", false
+	}
+	origin, err := common.NormalizeOrigin(parsed.Scheme + "://" + parsed.Host)
+	return origin, err == nil
+}
+
+// IsPrimaryRequest reports whether a browser request arrived on ServerAddress.
+// Every other host is a secondary entry point: it must not advertise the
+// primary address, the identity provider or any third-party sign-in provider,
+// so a visitor of a secondary domain never learns that the primary one exists.
+//
+// Without a usable ServerAddress the historical single-address behaviour is
+// kept and every request counts as primary, which also keeps first-run setup
+// working.
+func IsPrimaryRequest(request *http.Request) bool {
+	primary, ok := PrimaryOrigin()
+	if !ok {
+		return true
+	}
+	origin, ok := common.RequestPublicOrigin(request)
+	if !ok {
+		return false
+	}
+	return strings.EqualFold(origin, primary)
+}
