new file mode 100644
index 000000000..ea028f9b8
--- /dev/null
+++ b/common/site_origin.go
@@ -0,0 +1,37 @@
+package common
+
+import (
+	"net/http"
+	"strings"
+)
+
+// RequestPublicOrigin returns the exact origin (scheme://host[:port]) the
+// browser used for a request, honouring the forwarding headers of a reverse
+// proxy. Only the first value of a comma separated header is used, so a client
+// cannot append a second origin to the forwarded chain.
+func RequestPublicOrigin(request *http.Request) (string, bool) {
+	if request == nil {
+		return "", false
+	}
+	scheme := firstForwardedValue(request.Header.Get("X-Forwarded-Proto"))
+	if scheme == "" {
+		scheme = firstForwardedValue(request.Header.Get("X-Forwarded-Protocol"))
+	}
+	scheme = strings.ToLower(scheme)
+	if scheme != "http" && scheme != "https" {
+		scheme = "http"
+		if request.TLS != nil {
+			scheme = "https"
+		}
+	}
+	host := firstForwardedValue(request.Header.Get("X-Forwarded-Host"))
+	if host == "" {
+		host = request.Host
+	}
+	origin, err := NormalizeOrigin(scheme + "://" + host)
+	return origin, err == nil
+}
+
+func firstForwardedValue(value string) string {
+	return strings.TrimSpace(strings.Split(value, ",")[0])
+}
diff --git a/common/site_origin_test.go b/common/site_origin_test.go
new file mode 100644
index 000000000..2b3aff803
--- /dev/null
+++ b/common/site_origin_test.go
@@ -0,0 +1,96 @@
+package common
+
+import (
+	"crypto/tls"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRequestPublicOrigin(t *testing.T) {
+	tests := []struct {
+		name     string
+		host     string
+		tls      bool
+		headers  map[string]string
+		expected string
+		valid    bool
+	}{
+		{
+			name:     "plain http request",
+			host:     "panel.example.com",
+			expected: "http://panel.example.com",
+			valid:    true,
+		},
+		{
+			name:     "tls request",
+			host:     "panel.example.com",
+			tls:      true,
+			expected: "https://panel.example.com",
+			valid:    true,
+		},
+		{
+			name:     "forwarded proto overrides tls termination",
+			host:     "panel.example.com",
+			headers:  map[string]string{"X-Forwarded-Proto": "https"},
+			expected: "https://panel.example.com",
+			valid:    true,
+		},
+		{
+			name:     "forwarded host wins over backend host",
+			host:     "127.0.0.1:3000",
+			headers:  map[string]string{"X-Forwarded-Proto": "https", "X-Forwarded-Host": "shop.example.net"},
+			expected: "https://shop.example.net",
+			valid:    true,
+		},
+		{
+			name:     "only the first forwarded value counts",
+			host:     "127.0.0.1:3000",
+			headers:  map[string]string{"X-Forwarded-Proto": "https, http", "X-Forwarded-Host": "shop.example.net, evil.test"},
+			expected: "https://shop.example.net",
+			valid:    true,
+		},
+		{
+			name:     "default port is dropped",
+			host:     "panel.example.com:443",
+			tls:      true,
+			expected: "https://panel.example.com",
+			valid:    true,
+		},
+		{
+			name:     "non default port is kept",
+			host:     "panel.example.com:8443",
+			tls:      true,
+			expected: "https://panel.example.com:8443",
+			valid:    true,
+		},
+		{
+			name:     "empty host is rejected",
+			host:     "",
+			headers:  map[string]string{"X-Forwarded-Host": " "},
+			expected: "",
+			valid:    false,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			request := httptest.NewRequest("GET", "http://"+test.host+"/api/status", nil)
+			request.Host = test.host
+			if test.tls {
+				request.TLS = &tls.ConnectionState{}
+			}
+			for key, value := range test.headers {
+				request.Header.Set(key, value)
+			}
+			origin, ok := RequestPublicOrigin(request)
+			require.Equal(t, test.valid, ok)
+			assert.Equal(t, test.expected, origin)
+		})
+	}
+
+	_, ok := RequestPublicOrigin(nil)
+	assert.False(t, ok)
+}
