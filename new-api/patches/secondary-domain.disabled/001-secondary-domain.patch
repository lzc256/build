diff --git a/controller/site_scope.go b/controller/site_scope.go
new file mode 100644
index 000000000..e34977555
--- /dev/null
+++ b/controller/site_scope.go
@@ -0,0 +1,58 @@
+package controller
+
+import (
+	"slices"
+
+	"github.com/QuantumNous/new-api/service"
+
+	"github.com/gin-gonic/gin"
+)
+
+// hidePrimarySiteDetails blanks every /api/status field that would reveal the
+// primary address, the identity provider or the configured sign-in providers.
+// A secondary domain is a password-only entry point, so it answers exactly like
+// a site where those features were never configured. The SPA builds every link
+// from window.location.origin when these values are empty, so no frontend
+// change is required.
+func hidePrimarySiteDetails(data gin.H) {
+	data["server_address"] = ""
+	data["github_oauth"], data["github_client_id"] = false, ""
+	data["discord_oauth"], data["discord_client_id"] = false, ""
+	data["linuxdo_oauth"], data["linuxdo_client_id"] = false, ""
+	data["linuxdo_minimum_trust_level"] = 0
+	data["telegram_oauth"], data["telegram_oauth_configured"], data["telegram_bot_name"] = false, false, ""
+	data["wechat_login"], data["wechat_qrcode"] = false, ""
+	data["oidc_enabled"], data["oidc_client_id"] = false, ""
+	data["oidc_authorization_endpoint"], data["oidc_display_name"] = "", ""
+	data["passkey_login"], data["passkey_display_name"] = false, ""
+	data["passkey_rp_id"], data["passkey_rp_ids"] = "", []string{}
+	data["passkey_allow_insecure"] = false
+	// Administrator-authored API addresses may point at the primary domain, and
+	// the binding list names the providers that were just hidden.
+	delete(data, "api_info")
+	delete(data, "custom_oauth_providers")
+}
+
+// stripOAuthVerification drops linked-provider step-up verification on a
+// secondary domain. The alternative factors are kept, and a requirements object
+// with nothing else to offer is returned untouched so the caller still gets the
+// original sole-method error instead of an empty dialog.
+func stripOAuthVerification(requirements *service.VerificationRequirements) *service.VerificationRequirements {
+	if requirements == nil {
+		return nil
+	}
+	others := 0
+	for _, option := range requirements.Methods {
+		if option.Method != service.VerificationMethodOAuth {
+			others++
+		}
+	}
+	if others == 0 {
+		return requirements
+	}
+	requirements.OAuthProviders = []service.VerificationOAuthProvider{}
+	requirements.Methods = slices.DeleteFunc(requirements.Methods, func(option service.VerificationMethodOption) bool {
+		return option.Method == service.VerificationMethodOAuth
+	})
+	return requirements
+}
diff --git a/controller/site_scope_test.go b/controller/site_scope_test.go
new file mode 100644
index 000000000..3d29b018d
--- /dev/null
+++ b/controller/site_scope_test.go
@@ -0,0 +1,214 @@
+package controller
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/setting/system_setting"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestHidePrimarySiteDetailsBlanksAddressAndProviders(t *testing.T) {
+	data := gin.H{
+		"server_address":              "https://panel.example.com",
+		"github_client_id":            "gh-client",
+		"discord_client_id":           "dc-client",
+		"linuxdo_client_id":           "ld-client",
+		"telegram_bot_name":           "bot",
+		"wechat_qrcode":               "https://panel.example.com/qr.png",
+		"oidc_client_id":              "newapi",
+		"oidc_authorization_endpoint": "https://id.example.com/authorize",
+		"oidc_display_name":           "Company SSO",
+		"passkey_display_name":        "Shop",
+		"passkey_rp_id":               "panel.example.com",
+		"linuxdo_minimum_trust_level": 2,
+		"passkey_rp_ids":              []string{"panel.example.com"},
+		"api_info":                    []any{map[string]string{"url": "https://panel.example.com"}},
+		"custom_oauth_providers":      []any{map[string]string{"slug": "gitlab"}},
+	}
+
+	hidePrimarySiteDetails(data)
+
+	for _, key := range []string{
+		"server_address",
+		"github_client_id",
+		"discord_client_id",
+		"linuxdo_client_id",
+		"telegram_bot_name",
+		"wechat_qrcode",
+		"oidc_client_id",
+		"oidc_authorization_endpoint",
+		"oidc_display_name",
+		"passkey_display_name",
+		"passkey_rp_id",
+	} {
+		assert.Equal(t, "", data[key], "%s must be blanked on a secondary domain", key)
+	}
+	assert.Equal(t, 0, data["linuxdo_minimum_trust_level"])
+	assert.Equal(t, []string{}, data["passkey_rp_ids"])
+	for _, key := range []string{"api_info", "custom_oauth_providers"} {
+		_, ok := data[key]
+		assert.False(t, ok, "%s must not be advertised on a secondary domain", key)
+	}
+}
+
+func TestHidePrimarySiteDetailsDisablesProviders(t *testing.T) {
+	data := gin.H{
+		"github_oauth":              true,
+		"discord_oauth":             true,
+		"linuxdo_oauth":             true,
+		"telegram_oauth":            true,
+		"telegram_oauth_configured": true,
+		"wechat_login":              true,
+		"oidc_enabled":              true,
+		"passkey_login":             true,
+		"passkey_allow_insecure":    true,
+	}
+
+	hidePrimarySiteDetails(data)
+
+	for _, key := range []string{
+		"github_oauth",
+		"discord_oauth",
+		"linuxdo_oauth",
+		"telegram_oauth",
+		"telegram_oauth_configured",
+		"wechat_login",
+		"oidc_enabled",
+		"passkey_login",
+		"passkey_allow_insecure",
+	} {
+		assert.Equal(t, false, data[key], "%s must be disabled on a secondary domain", key)
+	}
+}
+
+func TestHidePrimarySiteDetailsLeavesPasswordLoginAlone(t *testing.T) {
+	data := gin.H{
+		"system_name":            "Shop",
+		"password_login_enabled": true,
+		"logo":                   "/logo.png",
+	}
+
+	hidePrimarySiteDetails(data)
+
+	assert.Equal(t, "Shop", data["system_name"])
+	assert.Equal(t, true, data["password_login_enabled"])
+	assert.Equal(t, "/logo.png", data["logo"])
+}
+
+func TestStripOAuthVerification(t *testing.T) {
+	requirements := &service.VerificationRequirements{
+		Scope: service.VerificationScopeAccountBind,
+		Methods: []service.VerificationMethodOption{
+			{Method: service.VerificationMethodPassword, Available: true},
+			{Method: service.VerificationMethodOAuth, Available: true},
+		},
+		OAuthProviders: []service.VerificationOAuthProvider{{Slug: "oidc", Name: "OIDC"}},
+	}
+
+	stripped := stripOAuthVerification(requirements)
+
+	assert.Equal(t, []service.VerificationMethodOption{
+		{Method: service.VerificationMethodPassword, Available: true},
+	}, stripped.Methods)
+	assert.Empty(t, stripped.OAuthProviders)
+}
+
+func TestStripOAuthVerificationKeepsSoleMethodForItsOriginalError(t *testing.T) {
+	requirements := &service.VerificationRequirements{
+		Methods: []service.VerificationMethodOption{
+			{Method: service.VerificationMethodOAuth, Available: false, Reason: "No linked OAuth provider is available."},
+		},
+	}
+
+	assert.Same(t, requirements, stripOAuthVerification(requirements))
+	assert.Len(t, requirements.Methods, 1)
+	assert.Nil(t, stripOAuthVerification(nil))
+}
+
+func statusPayloadFor(t *testing.T, rawURL string) (map[string]any, string) {
+	t.Helper()
+	response := httptest.NewRecorder()
+	context, _ := gin.CreateTestContext(response)
+	context.Request = httptest.NewRequest(http.MethodGet, rawURL, nil)
+
+	GetStatus(context)
+
+	var payload struct {
+		Success bool           `json:"success"`
+		Data    map[string]any `json:"data"`
+	}
+	require.NoError(t, common.Unmarshal(response.Body.Bytes(), &payload))
+	require.True(t, payload.Success)
+	return payload.Data, response.Body.String()
+}
+
+func TestGetStatusKeepsPrimaryAddressAndProviders(t *testing.T) {
+	restore := configureSecondaryDomainFixture(t)
+	defer restore()
+
+	data, body := statusPayloadFor(t, "https://panel.example.com/api/status")
+	assert.Equal(t, "https://panel.example.com", data["server_address"])
+	assert.Equal(t, true, data["oidc_enabled"])
+	assert.Equal(t, "https://id.example.com/authorize", data["oidc_authorization_endpoint"])
+	assert.Equal(t, true, data["passkey_login"])
+	assert.Contains(t, body, "panel.example.com")
+}
+
+func TestGetStatusOnSecondaryDomainHidesPrimarySite(t *testing.T) {
+	restore := configureSecondaryDomainFixture(t)
