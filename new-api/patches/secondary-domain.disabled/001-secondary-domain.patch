diff --git a/middleware/primary_origin.go b/middleware/primary_origin.go
new file mode 100644
index 000000000..681bd4b76
--- /dev/null
+++ b/middleware/primary_origin.go
@@ -0,0 +1,28 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/QuantumNous/new-api/setting/system_setting"
+
+	"github.com/gin-gonic/gin"
+)
+
+// PrimaryOriginOnly rejects authentication endpoints reached through a
+// secondary domain. Hiding a provider from /api/status only removes the button:
+// without this guard, anyone who knows the route could still start an OIDC
+// login from a secondary address and be handed the primary address by the
+// identity provider.
+func PrimaryOriginOnly() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if system_setting.IsPrimaryRequest(c.Request) {
+			c.Next()
+			return
+		}
+		c.AbortWithStatusJSON(http.StatusForbidden, gin.H{
+			"success": false,
+			"code":    "PRIMARY_ORIGIN_REQUIRED",
+			"message": "This sign-in method is not available on this address.",
+		})
+	}
+}
