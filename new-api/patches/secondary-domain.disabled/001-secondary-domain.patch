+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func withServerAddress(t *testing.T, value string) {
+	t.Helper()
+	previous := ServerAddress
+	ServerAddress = value
+	t.Cleanup(func() { ServerAddress = previous })
+}
+
+func TestPrimaryOrigin(t *testing.T) {
+	withServerAddress(t, "https://panel.example.com/")
+	origin, ok := PrimaryOrigin()
+	assert.True(t, ok)
+	assert.Equal(t, "https://panel.example.com", origin)
+
+	withServerAddress(t, "https://gateway.example.com/newapi")
+	origin, ok = PrimaryOrigin()
+	assert.True(t, ok)
+	assert.Equal(t, "https://gateway.example.com", origin)
+
+	withServerAddress(t, "")
+	_, ok = PrimaryOrigin()
+	assert.False(t, ok)
+
+	withServerAddress(t, "panel.example.com")
+	_, ok = PrimaryOrigin()
+	assert.False(t, ok)
+}
+
+func TestIsPrimaryRequest(t *testing.T) {
+	withServerAddress(t, "https://panel.example.com")
+
+	primary := httptest.NewRequest("GET", "https://panel.example.com/api/status", nil)
+	assert.True(t, IsPrimaryRequest(primary))
+
+	secondary := httptest.NewRequest("GET", "https://shop.example.net/api/status", nil)
+	assert.False(t, IsPrimaryRequest(secondary))
+
+	// A secondary domain hidden behind a proxy still identifies itself through
+	// the forwarded host, so it must stay secondary.
+	forwarded := httptest.NewRequest("GET", "http://127.0.0.1:3000/api/status", nil)
+	forwarded.Header.Set("X-Forwarded-Proto", "https")
+	forwarded.Header.Set("X-Forwarded-Host", "shop.example.net")
+	assert.False(t, IsPrimaryRequest(forwarded))
+
+	forwardedPrimary := httptest.NewRequest("GET", "http://127.0.0.1:3000/api/status", nil)
+	forwardedPrimary.Header.Set("X-Forwarded-Proto", "https")
+	forwardedPrimary.Header.Set("X-Forwarded-Host", "panel.example.com")
+	assert.True(t, IsPrimaryRequest(forwardedPrimary))
+}
+
+func TestIsPrimaryRequestWithoutServerAddressKeepsSingleAddressBehaviour(t *testing.T) {
+	withServerAddress(t, "")
+
+	request := httptest.NewRequest("GET", "https://anything.example.org/api/status", nil)
+	assert.True(t, IsPrimaryRequest(request))
+}
