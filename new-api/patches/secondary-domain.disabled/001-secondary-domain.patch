diff --git a/oauth/redirect_base.go b/oauth/redirect_base.go
new file mode 100644
index 000000000..aa7c38239
--- /dev/null
+++ b/oauth/redirect_base.go
@@ -0,0 +1,20 @@
+package oauth
+
+import (
+	"strings"
+
+	"github.com/QuantumNous/new-api/setting/system_setting"
+)
+
+// redirectBase returns the scheme://host[:port] the identity provider sends the
+// browser back to. The SPA always requests <browser origin>/oauth/<provider>,
+// and the token exchange must repeat that value verbatim (RFC 6749 §4.1.3), so
+// a trailing slash or a configured path prefix must never leak into it.
+// OAuth sign-in only runs on the primary address, which is what ServerAddress
+// names.
+func redirectBase() string {
+	if origin, ok := system_setting.PrimaryOrigin(); ok {
+		return origin
+	}
+	return strings.TrimRight(strings.TrimSpace(system_setting.ServerAddress), "/")
+}
