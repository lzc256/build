 web/default/src/i18n/locales/ru.json          |   4 +-
 web/default/src/i18n/locales/vi.json          |   4 +-
 web/default/src/i18n/locales/zh.json          |   4 +-
 7 files changed, 170 insertions(+), 9 deletions(-)

