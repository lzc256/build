+import type { ModelSettings } from '@/features/system-settings/types'
+import { safeJsonParse } from '@/features/system-settings/utils/json-parser'
 
-import { getMissingModels } from '../../api'
+import { getMissingModels, createModel, searchVendors } from '../../api'
 import { DEFAULT_PAGE_SIZE } from '../../constants'
 import { modelsQueryKeys } from '../../lib'
 import type { Model } from '../../types'
@@ -58,6 +67,11 @@ export function MissingModelsDialog({
   const [searchTerm, setSearchTerm] = useState('')
   const [currentPage, setCurrentPage] = useState(1)
 
+  const queryClient = useQueryClient()
+  const updateOption = useUpdateOption()
+  const { data: systemOptionsData } = useSystemOptions()
+  const [applyingDefault, setApplyingDefault] = useState<string | null>(null)
+
   const { data, isLoading, isError, error, refetch } = useQuery({
     queryKey: modelsQueryKeys.missing(),
     queryFn: async () => {
@@ -73,11 +87,118 @@ export function MissingModelsDialog({
   const missingModels = useMemo(() => data?.data || [], [data?.data])
   const pageSize = DEFAULT_PAGE_SIZE
 
+  const modelSettings = useMemo(() => {
+    if (!systemOptionsData?.data) return null
+    // Must provide all ModelSettings keys — getOptionValue only processes keys that exist in defaults.
+    const defaultModelSettings: ModelSettings = {
+      'global.pass_through_request_enabled': false,
+      'global.thinking_model_blacklist': '[]',
+      'global.chat_completions_to_responses_policy': '{}',
+      'global.responses_to_chat_completions_policy': '{}',
+      'general_setting.ping_interval_enabled': false,
+      'general_setting.ping_interval_seconds': 60,
+      'gemini.safety_settings': '',
+      'gemini.version_settings': '',
+      'gemini.supported_imagine_models': '',
+      'gemini.thinking_adapter_enabled': false,
+      'gemini.thinking_adapter_budget_tokens_percentage': 0.6,
+      'gemini.function_call_thought_signature_enabled': false,
+      'gemini.remove_function_response_id_enabled': true,
+      'claude.model_headers_settings': '',
+      'claude.default_max_tokens': '',
+      'claude.thinking_adapter_enabled': true,
+      'claude.thinking_adapter_budget_tokens_percentage': 0.8,
+      ModelPrice: '',
+      ModelRatio: '',
+      CacheRatio: '',
+      CompletionRatio: '',
+      ImageRatio: '',
+      AudioRatio: '',
+      AudioCompletionRatio: '',
+      ExposeRatioEnabled: false,
+      'billing_setting.billing_mode': '{}',
+      'billing_setting.billing_expr': '{}',
+      'billing_setting.plugin_billing_expr': '{}',
+      'tool_price_setting.prices': '{}',
+      TopupGroupRatio: '',
+      GroupRatio: '',
+      UserUsableGroups: '',
+      GroupGroupRatio: '',
+      AutoGroups: '',
+      MaxTokenAutoGroups: 0,
+      DefaultUseAutoGroup: false,
+      CreateCacheRatio: '',
+      'group_ratio_setting.group_special_usable_group': '{}',
+      'grok.violation_deduction_enabled': false,
+      'grok.violation_deduction_amount': 0,
+      'model_deployment.ionet.api_key': '',
+      'model_deployment.ionet.enabled': false,
+    }
+    return getOptionValue(systemOptionsData.data, defaultModelSettings)
+  }, [systemOptionsData])
+
   const handleConfigureModel = (modelName: string) => {
     setCurrentRow({ model_name: modelName } as unknown as Model)
     setOpen('create-model')
   }
 
+  const handleUseDefault = async (modelName: string) => {
+    setApplyingDefault(modelName)
+    try {
+      // Step 0: Look up vendor_id from vendor name
+      let vendorId: number | undefined
+      const vendorName = 'ふしきつ'
+      const vendorRes = await searchVendors({
+        keyword: vendorName,
+        page_size: 1,
+      })
+      if (vendorRes.success && vendorRes.data?.items?.length) {
+        vendorId = vendorRes.data.items[0].id
+      }
+
+      // Step 1: Create model record
+      const modelPayload: Record<string, unknown> = {
+        model_name: modelName,
+        name_rule: 0,
+        status: 1,
+        sync_official: 1,
+      }
+      if (vendorId !== undefined) {
+        modelPayload.vendor_id = vendorId
+      }
+      const response = await createModel(modelPayload as Partial<Model>)
+      if (!response.success) {
+        toast.error(response.message || 'Failed to create model')
+        return
+      }
+
+      // Step 2: Update ModelPrice in system options
+      if (modelSettings) {
+        const priceMap = safeJsonParse<Record<string, number>>(
+          modelSettings.ModelPrice,
+          { fallback: {}, silent: true }
+        )
+        priceMap[modelName] = 0.01
+        const newModelPrice = normalizeJsonString(JSON.stringify(priceMap))
+        if (newModelPrice !== normalizeJsonString(modelSettings.ModelPrice)) {
+          await updateOption.mutateAsync({
+            key: 'ModelPrice',
+            value: newModelPrice,
+          })
+        }
+      }
+
+      toast.success(t('Model configured with default pricing'))
+      queryClient.invalidateQueries({ queryKey: modelsQueryKeys.lists() })
+      queryClient.invalidateQueries({ queryKey: modelsQueryKeys.missing() })
+      queryClient.invalidateQueries({ queryKey: ['system-options'] })
+    } catch (error) {
+      toast.error((error as Error)?.message || 'Operation failed')
+    } finally {
+      setApplyingDefault(null)
+    }
+  }
+
   useEffect(() => {
     if (open) {
       // eslint-disable-next-line react-hooks/set-state-in-effect
@@ -201,6 +322,20 @@ export function MissingModelsDialog({
                         copyText={modelName}
                       />
                     </div>
+                    <Button
+                      variant='outline'
+                      size='sm'
+                      className='flex-shrink-0 gap-1'
+                      onClick={() => handleUseDefault(modelName)}
+                      disabled={applyingDefault !== null}
+                    >
+                      {applyingDefault === modelName ? (
+                        <Loader2 className='h-4 w-4 animate-spin' />
+                      ) : (
+                        <Zap className='h-4 w-4' />
+                      )}
+                      {t('Use Default')}
+                    </Button>
                     <Button
                       size='sm'
                       className='flex-shrink-0 gap-1'
