diff --git a/plugins/tasks/request-mask/plugin.js b/plugins/tasks/request-mask/plugin.js
new file mode 100644
index 000000000..ac5386837
--- /dev/null
+++ b/plugins/tasks/request-mask/plugin.js
@@ -0,0 +1,110 @@
+export const meta = {
+  apiVersion: 1,
+  key: "request-mask",
+  name: { en: "Request mask (Magpie)", zh: "请求脱敏（Magpie）" },
+  description: {
+    en: "Replaces secrets and personal data with magpie placeholders before sending; replies are restored automatically.",
+    zh: "发送前使用 magpie 规则把密钥和个人信息替换为占位符，回复自动还原。",
+  },
+  version: "1.0.3",
+  author: { name: "lzc256" },
+  configSchema: {
+    type: "object",
+    properties: {
+      secrets: {
+        type: "boolean",
+        title: { en: "Mask secrets", zh: "脱敏密钥" },
+        description: { en: "API keys, tokens, private keys and passwords", zh: "API 密钥、令牌、私钥和密码" },
+        default: true,
+      },
+      personal: {
+        type: "boolean",
+        title: { en: "Mask personal data", zh: "脱敏个人信息" },
+        description: { en: "Emails, phone numbers, ID and bank card numbers", zh: "邮箱、手机号、身份证号和银行卡号" },
+        default: true,
+      },
+      names: {
+        type: "string",
+        format: "textarea",
+        title: { en: "Names to mask", zh: "需要脱敏的人名" },
+        description: {
+          en: "One name per line. Always masked, with or without the local model.",
+          zh: "每行一个名字。无论是否启用本地模型都会脱敏。",
+        },
+        default: "",
+      },
+      model: {
+        type: "string",
+        enum: ["off", "astrlink"],
+        enumTitles: [
+          { en: "Off (rules only)", zh: "关闭（仅规则）" },
+          { en: "AstrLink Guard (37 MB)", zh: "AstrLink Guard（37 MB）" },
+        ],
+        title: { en: "Local PII model", zh: "本地 PII 模型" },
+        description: {
+          en: "Find names, addresses and passwords that rules miss. Downloads once and runs on this server.",
+          zh: "识别规则漏掉的人名、地址和密码。首次使用时下载并运行在本机。",
+        },
+        default: "off",
+      },
+      names_by_model: {
+        type: "boolean",
+        title: { en: "Use model for full names", zh: "用模型识别完整人名" },
+        description: {
+          en: "AstrLink Guard finds full Chinese names; the rules then only add nicknames.",
+          zh: "AstrLink Guard 能识别完整中文人名，规则只补充昵称。",
+        },
+        default: true,
+        visibleWhen: { model: ["astrlink"] },
+      },
+    },
+  },
+  samples: [
+    {
+      name: { en: "Email and API key", zh: "邮箱和 API 密钥" },
+      lang: "en",
+      format: "openai",
+      body: {
+        model: "gpt-4o-mini",
+        messages: [
+          {
+            role: "user",
+            content: "Send the report to [REDACTED] using sk-abcdefghijklmnopqrstuv.",
+          },
+        ],
+      },
+    },
+  ],
+};
+
+function requestMeta(ctx) {
+  const config = ctx.config || {};
+  const names = String(config.names || "")
+    .split(/\r?\n/)
+    .map((name) => name.trim())
+    .filter(Boolean);
+  return JSON.stringify({
+    secrets: config.secrets !== false,
+    personal: config.personal !== false,
+    names,
+    pii_model: config.model === "astrlink" ? "astrlink" : "off",
+    names_by_model: config.names_by_model !== false,
+    path: ctx.path || "",
+    model: ctx.model || "",
+    user_id: ctx.user && ctx.user.id ? String(ctx.user.id) : "",
+  });
+}
+
+function mask(ctx, req) {
+  const opsText = utils.magpieMaskPatch(JSON.stringify(req.body), requestMeta(ctx));
+  const ops = JSON.parse(opsText || "[]");
+  if (!ops.length) return { action: "continue" };
+  return {
+    action: "continue",
+    effects: [{ type: "json.patch", ops }],
+  };
+}
+
+export function ingress(ctx, req) { return mask(ctx, req); }
+export function egress() { return { action: "continue" }; }
+export function reply() { return { action: "pass" }; }
