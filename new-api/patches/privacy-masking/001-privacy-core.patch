@@ -0,0 +1,58 @@
+package privacy
+
+import (
+	"net/http"
+	"strconv"
+
+	"github.com/gin-gonic/gin"
+)
+
+// RegisterAdminRoutes adds the dashboard endpoints to an admin route group.
+func RegisterAdminRoutes(routes gin.IRoutes) {
+	routes.GET("/privacy/masking/summary", privacySummaryHandler)
+	routes.GET("/privacy/masking/events", privacyEventsHandler)
+	routes.DELETE("/privacy/masking/events", privacyClearHandler)
+}
+
+func privacySummaryHandler(c *gin.Context) {
+	days := queryInt(c, "days", 7, 1, 90)
+	summary, err := insights.summary(days)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "message": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": summary})
+}
+
+func privacyEventsHandler(c *gin.Context) {
+	days := queryInt(c, "days", 7, 1, 90)
+	limit := queryInt(c, "limit", 100, 1, 1000)
+	events, err := insights.events(days, c.Query("kind"), limit)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "message": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": events})
+}
+
+func privacyClearHandler(c *gin.Context) {
+	if err := insights.clear(); err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "message": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": gin.H{"cleared": true}})
+}
+
+func queryInt(c *gin.Context, key string, fallback, min, max int) int {
+	v, err := strconv.Atoi(c.Query(key))
+	if err != nil || v <= 0 {
+		return fallback
+	}
+	if v < min {
+		return min
+	}
+	if v > max {
+		return max
+	}
+	return v
+}
diff --git a/privacy/gin_writer.go b/privacy/gin_writer.go
new file mode 100644
index 000000000..7ba80b38c
--- /dev/null
+++ b/privacy/gin_writer.go
@@ -0,0 +1,30 @@
+package privacy
+
+import (
+	"net/http"
+
+	"github.com/QuantumNous/new-api/internal/privacy/redact"
+	"github.com/gin-gonic/gin"
+)
+
+// ginWriter makes magpie's http.ResponseWriter wrapper usable as gin's
+// richer ResponseWriter. All data methods go through the redact writer so
+// restored values reach the client; metadata methods stay with gin.
+type ginWriter struct {
+	gin.ResponseWriter
+	rw *redact.Writer
+}
+
+func (w *ginWriter) Header() http.Header { return w.rw.Header() }
+
+func (w *ginWriter) Write(p []byte) (int, error) { return w.rw.Write(p) }
+
+func (w *ginWriter) WriteString(s string) (int, error) { return w.Write([]byte(s)) }
+
+func (w *ginWriter) WriteHeader(code int) { w.rw.WriteHeader(code) }
+
+// WriteHeaderNow is called by gin right before writing. Delegate to the
+// redact writer so it can drop Content-Length before the header is frozen.
+func (w *ginWriter) WriteHeaderNow() { w.rw.WriteHeader(w.ResponseWriter.Status()) }
+
+func (w *ginWriter) Flush() { w.rw.Flush() }
diff --git a/privacy/insights.go b/privacy/insights.go
new file mode 100644
index 000000000..4b864a2c3
--- /dev/null
+++ b/privacy/insights.go
@@ -0,0 +1,221 @@
+package privacy
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// MaskEvent is one magpie hit. It deliberately contains no raw value: Head
+// and Len are magpie's Hint, and Placeholder is the token sent upstream.
+type MaskEvent struct {
+	ID          string    `json:"id"`
+	Time        time.Time `json:"time"`
+	RequestID   string    `json:"request_id"`
+	Path        string    `json:"path"`
+	Model       string    `json:"model,omitempty"`
+	UserID      string    `json:"user_id,omitempty"`
+	Kind        string    `json:"kind"`
+	By          string    `json:"by"`
+	Action      string    `json:"action,omitempty"`
+	Placeholder string    `json:"placeholder"`
+	Head        string    `json:"head"`
+	Len         int       `json:"len"`
+}
+
+// InsightSummary is the small aggregate the dashboard needs.
+type InsightSummary struct {
+	Days     int            `json:"days"`
+	Total    int            `json:"total"`
+	Requests int            `json:"requests"`
+	ByKind   map[string]int `json:"by_kind"`
+	ByDay    map[string]int `json:"by_day"`
+	ByModel  map[string]int `json:"by_model"`
+}
+
+type insightStore struct {
+	mu        sync.RWMutex
+	path      string
+	retention time.Duration
+	maxLines  int
+}
+
+var (
+	insights   = newInsightStore()
+	requestSeq uint64
+)
+
+func newInsightStore() *insightStore {
+	path := os.Getenv("PRIVACY_INSIGHTS_PATH")
+	if path == "" {
+		path = filepath.Join("data", "privacy-masking.jsonl")
+	}
+	s := &insightStore{
+		path:      path,
+		retention: 30 * 24 * time.Hour,
+		maxLines:  100000,
+	}
+	go s.cleanupLoop()
+	return s
+}
+
+func nextRequestID() string {
+	return fmt.Sprintf("%d-%d", time.Now().UnixNano(), atomic.AddUint64(&requestSeq, 1))
+}
+
+func (s *insightStore) record(e MaskEvent) {
+	if e.ID == "" {
+		e.ID = fmt.Sprintf("%d-%d", time.Now().UnixNano(), atomic.AddUint64(&requestSeq, 1))
+	}
+	if e.Time.IsZero() {
+		e.Time = time.Now()
+	}
+	line, err := json.Marshal(e)
+	if err != nil {
+		return
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := os.MkdirAll(filepath.Dir(s.path), 0o755); err != nil {
+		return
+	}
+	f, err := os.OpenFile(s.path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	_, _ = f.Write(append(line, '\n'))
+}
+
+func (s *insightStore) cleanupLoop() {
+	ticker := time.NewTicker(time.Hour)
+	defer ticker.Stop()
+	s.cleanup()
+	for range ticker.C {
+		s.cleanup()
+	}
+}
+
+func (s *insightStore) cleanup() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	f, err := os.Open(s.path)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+
+	cutoff := time.Now().Add(-s.retention)
+	lines := make([]string, 0)
+	scanner := bufio.NewScanner(f)
+	scanner.Buffer(make([]byte, 64*1024), 1024*1024)
+	for scanner.Scan() {
+		line := scanner.Text()
+		var e MaskEvent
+		if json.Unmarshal([]byte(line), &e) == nil && e.Time.After(cutoff) {
+			lines = append(lines, line)
+		}
+	}
+	if len(lines) > s.maxLines {
+		lines = lines[len(lines)-s.maxLines:]
+	}
+
+	tmp := s.path + ".tmp"
+	content := strings.Join(lines, "\n")
+	if content != "" {
+		content += "\n"
+	}
+	if err := os.WriteFile(tmp, []byte(content), 0o600); err != nil {
+		return
+	}
+	_ = os.Rename(tmp, s.path)
+}
+
+func (s *insightStore) events(days int, kind string, limit int) ([]MaskEvent, error) {
+	if days <= 0 {
+		days = 7
+	}
+	cutoff := time.Now().Add(-time.Duration(days) * 24 * time.Hour)
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	f, err := os.Open(s.path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return []MaskEvent{}, nil
+		}
+		return nil, err
+	}
+	defer f.Close()
+
+	out := make([]MaskEvent, 0)
+	scanner := bufio.NewScanner(f)
+	scanner.Buffer(make([]byte, 64*1024), 1024*1024)
+	for scanner.Scan() {
+		var e MaskEvent
+		if json.Unmarshal(scanner.Bytes(), &e) != nil {
+			continue
+		}
+		if e.Time.Before(cutoff) {
+			continue
+		}
+		if kind != "" && e.Kind != kind {
+			continue
+		}
+		out = append(out, e)
+	}
+	if err := scanner.Err(); err != nil {
+		return nil, err
+	}
+
+	sort.Slice(out, func(i, j int) bool { return out[i].Time.After(out[j].Time) })
+	if limit > 0 && len(out) > limit {
+		out = out[:limit]
+	}
+	return out, nil
+}
+
+func (s *insightStore) summary(days int) (InsightSummary, error) {
+	all, err := s.events(days, "", 0)
+	if err != nil {
+		return InsightSummary{}, err
+	}
+	res := InsightSummary{
+		Days:    days,
+		Total:   len(all),
+		ByKind:  map[string]int{},
+		ByDay:   map[string]int{},
+		ByModel: map[string]int{},
+	}
+	requests := map[string]struct{}{}
+	for _, e := range all {
+		requests[e.RequestID] = struct{}{}
+		res.ByKind[e.Kind]++
+		res.ByDay[e.Time.Format("2006-01-02")]++
+		if e.Model != "" {
+			res.ByModel[e.Model]++
+		}
+	}
+	res.Requests = len(requests)
+	return res, nil
+}
+
+func (s *insightStore) clear() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	err := os.Remove(s.path)
+	if err != nil && os.IsNotExist(err) {
+		return nil
+	}
+	return err
+}
