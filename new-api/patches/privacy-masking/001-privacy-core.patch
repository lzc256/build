index 000000000..6a8d95c79
--- /dev/null
+++ b/privacy/integration_test.go
@@ -0,0 +1,65 @@
+package privacy
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func TestMaskJSONForJSUsesMagpieAndRecordsMetadata(t *testing.T) {
+	plaintext := "alice" + "@" + "acme" + ".com"
+	body, _ := json.Marshal(map[string]string{"prompt": "contact " + plaintext})
+	meta, _ := json.Marshal(map[string]any{"secrets": true, "personal": true, "path": "/v1/chat/completions"})
+
+	masked, err := MaskJSONForJS(body, string(meta))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if masked == string(body) || strings.Contains(masked, plaintext) {
+		t.Fatalf("body was not masked: %s", masked)
+	}
+	events, err := insights.events(1, "EMAIL", 10)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(events) == 0 {
+		t.Fatal("no EMAIL insight recorded")
+	}
+	if strings.Contains(events[0].Placeholder, plaintext) {
+		t.Fatal("insight contains plaintext")
+	}
+}
+
+func TestMaskPatchForJSSkipsMediaPlaceholders(t *testing.T) {
+	plaintext := "bob" + "@" + "acme" + ".com"
+	body := []byte(fmt.Sprintf(`{"model":"gpt-4o-mini","messages":[{"role":"user","content":[{"type":"text","text":"mail %s"},{"type":"image_url","image_url":{"url":"[media:0]"}}]}]}`, plaintext))
+	meta, _ := json.Marshal(map[string]any{"secrets": true, "personal": true, "path": "/v1/messages"})
+
+	patch, err := MaskPatchForJS(body, string(meta))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ops []struct {
+		Op    string          `json:"op"`
+		Path  string          `json:"path"`
+		Value json.RawMessage `json:"value"`
+	}
+	if err := json.Unmarshal([]byte(patch), &ops); err != nil {
+		t.Fatal(err)
+	}
+	if len(ops) == 0 {
+		t.Fatal("no patch operations")
+	}
+	for _, op := range ops {
+		if op.Op != "replace" || op.Path == "" {
+			t.Fatalf("unexpected op: %+v", op)
+		}
+		if strings.Contains(string(op.Value), "[media:") {
+			t.Fatalf("media placeholder leaked into patch: %s", patch)
+		}
+		if strings.Contains(string(op.Value), plaintext) {
+			t.Fatalf("plaintext leaked into patch: %s", patch)
+		}
+	}
+}
diff --git a/privacy/middleware.go b/privacy/middleware.go
new file mode 100644
index 000000000..4237c297a
--- /dev/null
+++ b/privacy/middleware.go
@@ -0,0 +1,33 @@
+package privacy
+
+import (
+	"strings"
+
+	"github.com/QuantumNous/new-api/internal/privacy/redact"
+	"github.com/gin-gonic/gin"
+)
+
+// Middleware restores magpie placeholders in responses. Request masking is
+// performed by the builtin request-mask plugin through the Go host function,
+// so enabling/disabling the plugin controls masking while restoration remains
+// a harmless no-op when no placeholders were produced.
+func Middleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if !isRelayPath(c.Request.URL.Path) || strings.EqualFold(c.GetHeader("Upgrade"), "websocket") {
+			c.Next()
+			return
+		}
+
+		original := c.Writer
+		rw := redact.NewWriter(original)
+		c.Writer = &ginWriter{ResponseWriter: original, rw: rw}
+		defer rw.Finish()
+
+		c.Next()
+	}
+}
+
+func isRelayPath(path string) bool {
+	return path == "/v1" || path == "/v1beta" ||
+		strings.HasPrefix(path, "/v1/") || strings.HasPrefix(path, "/v1beta/")
+}
diff --git a/privacy/plugin.go b/privacy/plugin.go
new file mode 100644
index 000000000..25b414dac
--- /dev/null
+++ b/privacy/plugin.go
@@ -0,0 +1,174 @@
+package privacy
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/QuantumNous/new-api/internal/privacy/redact"
+)
+
+type pluginMaskOptions struct {
+	Secrets  *bool  `json:"secrets"`
+	Personal *bool  `json:"personal"`
+	Path     string `json:"path"`
+	Model    string `json:"model"`
+	UserID   string `json:"user_id"`
+}
+
+type maskPatchOperation struct {
+	Op    string          `json:"op"`
+	Path  string          `json:"path"`
+	Value json.RawMessage `json:"value"`
+}
+
+const maxMaskPatchOps = 512
+
+func pluginMaskOptionsFromMeta(metaJSON string) (pluginMaskOptions, redact.Options, error) {
+	opts := redact.Options{Secrets: true, Personal: true}
+	var meta pluginMaskOptions
+	if metaJSON != "" {
+		if err := json.Unmarshal([]byte(metaJSON), &meta); err != nil {
+			return meta, opts, fmt.Errorf("invalid request-mask metadata: %w", err)
+		}
+	}
+	if meta.Secrets != nil {
+		opts.Secrets = *meta.Secrets
+	}
+	if meta.Personal != nil {
+		opts.Personal = *meta.Personal
+	}
+	return meta, opts, nil
+}
+
+func maskJSONWithMeta(body []byte, metaJSON string) ([]byte, MaskEvent, error) {
+	meta, opts, err := pluginMaskOptionsFromMeta(metaJSON)
+	if err != nil {
+		return nil, MaskEvent{}, err
+	}
+	base := MaskEvent{RequestID: nextRequestID(), Path: meta.Path, Model: meta.Model, UserID: meta.UserID}
+	opts.Seen = func(h redact.Hit) {
+		e := base
+		e.Kind = h.Kind
+		e.By = h.By
+		e.Action = h.Action
+		e.Placeholder = h.Placeholder
+		e.Head = h.Head
+		e.Len = h.Len
+		insights.record(e)
+	}
+	masked, _ := redact.MaskJSON(body, opts)
+	return masked, base, nil
+}
+
+// MaskJSONForJS is kept for diagnostics and tests. The plugin itself uses
+// MaskPatchForJS so that media placeholders are never sent back in an effect.
+func MaskJSONForJS(body []byte, metaJSON string) (string, error) {
+	masked, _, err := maskJSONWithMeta(body, metaJSON)
+	if err != nil {
+		return "", err
+	}
+	return string(masked), nil
+}
+
+// MaskPatchForJS returns an RFC 6901 JSON Patch of only the changed leaves.
+// requestplugin refuses an effect value containing "[media:N]"; emitting leaf
+// ops lets media-bearing requests be masked without tripping that guard.
+func MaskPatchForJS(body []byte, metaJSON string) (string, error) {
+	masked, _, err := maskJSONWithMeta(body, metaJSON)
+	if err != nil {
+		return "", err
+	}
+	var before, after any
+	if err := decodeJSONValue(body, &before); err != nil {
+		return "[]", nil
+	}
+	if err := decodeJSONValue(masked, &after); err != nil {
+		return "[]", nil
+	}
+	ops := make([]maskPatchOperation, 0)
+	collectMaskPatchOps(before, after, "", &ops)
+	out, err := json.Marshal(ops)
+	if err != nil {
+		return "", err
+	}
+	return string(out), nil
+}
+
+func decodeJSONValue(data []byte, dst any) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	return decoder.Decode(dst)
+}
+
+func collectMaskPatchOps(before, after any, path string, ops *[]maskPatchOperation) {
+	if len(*ops) >= maxMaskPatchOps {
+		return
+	}
+	switch old := before.(type) {
+	case map[string]any:
+		newValue, ok := after.(map[string]any)
+		if !ok {
+			appendMaskPatchOp(path, after, ops)
+			return
+		}
+		keys := make([]string, 0, len(newValue))
+		for key := range newValue {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			childPath := path + "/" + maskPointerToken(key)
+			oldChild, exists := old[key]
+			if !exists {
+				appendMaskPatchOp(childPath, newValue[key], ops)
+				continue
+			}
+			collectMaskPatchOps(oldChild, newValue[key], childPath, ops)
+		}
+	case []any:
+		newValue, ok := after.([]any)
+		if !ok || len(newValue) != len(old) {
+			appendMaskPatchOp(path, after, ops)
+			return
+		}
+		for i := range old {
+			collectMaskPatchOps(old[i], newValue[i], path+"/"+strconv.Itoa(i), ops)
+		}
+	default:
+		if !jsonValuesEqual(before, after) {
+			appendMaskPatchOp(path, after, ops)
+		}
+	}
+}
+
+func appendMaskPatchOp(path string, value any, ops *[]maskPatchOperation) {
+	if len(*ops) >= maxMaskPatchOps {
+		return
+	}
+	raw, err := json.Marshal(value)
+	if err != nil || strings.Contains(string(raw), "[media:") {
+		return
+	}
+	*ops = append(*ops, maskPatchOperation{Op: "replace", Path: path, Value: raw})
+}
+
+func jsonValuesEqual(a, b any) bool {
+	left, err := json.Marshal(a)
+	if err != nil {
+		return false
+	}
+	right, err := json.Marshal(b)
+	if err != nil {
+		return false
+	}
+	return bytes.Equal(left, right)
+}
+
+func maskPointerToken(token string) string {
+	token = strings.ReplaceAll(token, "~", "~0")
+	return strings.ReplaceAll(token, "/", "~1")
+}
