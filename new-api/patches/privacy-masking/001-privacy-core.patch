@@ -0,0 +1,43 @@
+package privacy
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestInsightStoreKeepsMetadataOnly(t *testing.T) {
+	dir := t.TempDir()
+	s := &insightStore{
+		path:      filepath.Join(dir, "privacy.jsonl"),
+		retention: 30 * 24 * time.Hour,
+		maxLines:  100,
+	}
+	plaintext := "alice" + "@" + "acme" + ".com"
+	s.record(MaskEvent{
+		RequestID:   "req-1",
+		Path:        "/v1/chat/completions",
+		Kind:        "EMAIL",
+		By:          "rule",
+		Placeholder: "{{EMAIL_abcdefgh}}",
+		Head:        "a",
+		Len:         len(plaintext),
+	})
+
+	sum, err := s.summary(7)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sum.Total != 1 || sum.Requests != 1 || sum.ByKind["EMAIL"] != 1 {
+		t.Fatalf("unexpected summary: %+v", sum)
+	}
+	raw, err := os.ReadFile(s.path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(raw), plaintext) {
+		t.Fatalf("insight file contains plaintext: %s", raw)
+	}
+}
diff --git a/privacy/integration_test.go b/privacy/integration_test.go
