diff --git a/controller/channel_balance_script.go b/controller/channel_balance_script.go
new file mode 100644
index 000000000..7ec45d9be
--- /dev/null
+++ b/controller/channel_balance_script.go
@@ -0,0 +1,475 @@
+package controller
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/model"
+	"github.com/dop251/goja"
+)
+
+const (
+	balanceScriptTimeout      = 30 * time.Second   // wall clock cap for a whole script run
+	balanceScriptFetchTimeout = 10 * time.Second   // per-request cap inside fetch()
+	balanceScriptMaxMessage   = 72 * 1024          // 72KB cap on collected debug output (extra room for state JSON)
+	balanceScriptMaxStateLen  = 65536              // 64KB max state size
+	balanceScriptMaxSourceLen = 65536              // 64KB max script size
+	balanceScriptMaxBodyLen   = 1024 * 1024        // 1MB cap on a single fetch() response body
+	balanceScriptMaxFetches   = 16                 // max fetch() calls per run
+	balanceScriptMaxCallStack = 256                // max JS call depth
+	balanceScriptMaxRedirects = 3                  // max HTTP redirects followed by fetch()
+	balanceScriptStateUnwrap  = 8                  // max JSON string unwrapping steps for legacy state
+	balanceScriptScriptName   = "<balance_script>" //
+)
+
+// updateChannelBalanceScript executes a user-defined JavaScript script to fetch channel balance.
+//
+// The script talks to the host through the single global object `newapi`:
+//
+//	newapi.environ.CHANNEL_BASE_URL   // channel base URL
+//	newapi.environ.CHANNEL_KEY        // API key (multi-key channels: all keys joined by ",")
+//	newapi.environ.CHANNEL_TYPE       // channel type integer, as string
+//	newapi.environ.CHANNEL_ID         // channel id, as string
+//	newapi.environ.CHANNEL_IS_MULTI_KEY // "1" for multi-key channels, "0" otherwise
+//
+//	newapi.fetch({url, method?, headers?, body?}) // -> {status, headers, body}; http(s) only
+//	newapi.state.get()      // previous state, parsed ( {} on first run )
+//	newapi.state.getRaw()   // previous state, raw string
+//	newapi.state.save(obj)  // persist any JSON-serializable value ( <= 64KB )
+//	newapi.state.saveRaw(s) // persist a raw string
+//	newapi.debug.log(...)   // collect a debug/message line ( <= 72KB total )
+//	newapi.balance.set(n)   // required: the balance to store
+//
+// print(), require(), file system, processes and raw sockets are not available.
+//
+// Limits are enforced at the entry points rather than through a process sandbox:
+// script size, one response body, fetch count, call depth, collected messages and
+// state size are all capped, and the whole run is interrupted after the wall clock
+// timeout. A runaway script can therefore still allocate memory through plain JS
+// value construction; that is accepted.
+func updateChannelBalanceScript(channel *model.Channel, script string) (float64, string, error) {
+	// Acquire per-channel lock to serialize state read/write
+	lock := model.GetChannelPollingLock(channel.Id)
+	lock.Lock()
+	defer lock.Unlock()
+
+	if len(script) > balanceScriptMaxSourceLen {
+		return 0, "", fmt.Errorf("balance script exceeds %d bytes", balanceScriptMaxSourceLen)
+	}
+
+	program, err := goja.Compile(balanceScriptScriptName, script, false)
+	if err != nil {
+		return 0, "", fmt.Errorf("balance script error: %s", err)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), balanceScriptTimeout)
+	defer cancel()
+
+	runtime := newBalanceScriptRuntime(ctx, channel)
+
+	// Interrupt is checked by the VM every few instructions; it is the only way to
+	// stop a runaway script now that no separate process is involved. An interrupted
+	// runtime cannot be reused, which is fine here: every run builds a fresh one.
+	timer := time.AfterFunc(balanceScriptTimeout, func() {
+		runtime.vm.Interrupt("balance script timed out after " + balanceScriptTimeout.String())
+	})
+	defer timer.Stop()
+
+	_, err = runtime.run(program)
+	if err != nil {
+		return 0, "", err
+	}
+
+	if !runtime.hasBalance {
+		return 0, "", fmt.Errorf("balance script error: newapi.balance.set() was never called")
+	}
+
+	// Atomic update: write state first, then balance
+	if runtime.hasState {
+		if err := channel.UpdateBalanceScriptState(runtime.state); err != nil {
+			return 0, "", fmt.Errorf("failed to save balance script state: %w", err)
+		}
+	}
+	channel.UpdateBalance(runtime.balance)
+
+	return runtime.balance, runtime.message(), nil
+}
+
+// balanceScriptRuntime is the host side of a single script run: it owns the
+// goja runtime and collects everything the script reports back.
+type balanceScriptRuntime struct {
+	vm      *goja.Runtime
+	ctx     context.Context
+	channel *model.Channel
+
+	balance    float64
+	hasBalance bool
+
+	state    string
+	hasState bool
+
+	lines      []string
+	messageLen int
+	truncated  bool
+
+	fetches int
+}
+
+func newBalanceScriptRuntime(ctx context.Context, channel *model.Channel) *balanceScriptRuntime {
+	key := channel.Key
+	isMultiKey := "0"
+	if channel.ChannelInfo.IsMultiKey {
+		key = strings.Join(channel.GetKeys(), ",")
+		isMultiKey = "1"
+	}
+
+	rt := &balanceScriptRuntime{
+		vm:      goja.New(),
+		ctx:     ctx,
+		channel: channel,
+	}
+	rt.vm.SetMaxCallStackSize(balanceScriptMaxCallStack)
+
+	environ := rt.vm.NewObject()
+	for name, value := range map[string]string{
+		"CHANNEL_BASE_URL":     channel.GetBaseURL(),
+		"CHANNEL_KEY":          key,
+		"CHANNEL_TYPE":         strconv.Itoa(channel.Type),
+		"CHANNEL_ID":           strconv.Itoa(channel.Id),
+		"CHANNEL_IS_MULTI_KEY": isMultiKey,
+	} {
+		_ = environ.Set(name, value)
+	}
+
+	state := rt.vm.NewObject()
+	_ = state.Set("get", rt.stateGet)
+	_ = state.Set("getRaw", rt.stateGetRaw)
+	_ = state.Set("save", rt.stateSave)
+	_ = state.Set("saveRaw", rt.stateSaveRaw)
+
+	balance := rt.vm.NewObject()
+	_ = balance.Set("set", rt.balanceSet)
+
+	debug := rt.vm.NewObject()
+	_ = debug.Set("log", rt.debugLog)
+
+	newapi := rt.vm.NewObject()
+	_ = newapi.Set("environ", environ)
+	_ = newapi.Set("state", state)
+	_ = newapi.Set("balance", balance)
+	_ = newapi.Set("debug", debug)
+	_ = newapi.Set("fetch", rt.fetch)
+
+	_ = rt.vm.Set("newapi", newapi)
+
+	return rt
+}
+
+// run executes the compiled program and converts goja failures into plain errors.
+func (rt *balanceScriptRuntime) run(program *goja.Program) (result goja.Value, err error) {
+	defer func() {
+		// goja converts JS exceptions itself, but a panic escaping a host callback
+		// would otherwise take the whole server down.
+		if recovered := recover(); recovered != nil {
+			err = fmt.Errorf("balance script panic: %v", recovered)
+		}
+	}()
+
+	result, err = rt.vm.RunProgram(program)
+	if err == nil {
+		return result, nil
+	}
+
+	var interrupted *goja.InterruptedError
+	if errors.As(err, &interrupted) {
+		return nil, fmt.Errorf("balance script error: %v", interrupted.Value())
+	}
+
+	var exception *goja.Exception
+	if errors.As(err, &exception) {
+		return nil, fmt.Errorf("balance script error: %s", exception.String())
+	}
+
+	return nil, fmt.Errorf("balance script error: %w", err)
+}
+
+func (rt *balanceScriptRuntime) message() string {
+	return strings.Join(rt.lines, "\n")
+}
+
+func (rt *balanceScriptRuntime) balanceSet(call goja.FunctionCall) goja.Value {
+	value := call.Argument(0)
+	if goja.IsUndefined(value) || goja.IsNull(value) || goja.IsNaN(value) {
+		panic(rt.vm.NewTypeError("newapi.balance.set() requires a number"))
+	}
+	rt.balance = value.ToFloat()
+	rt.hasBalance = true
+	return goja.Undefined()
+}
+
+func (rt *balanceScriptRuntime) debugLog(call goja.FunctionCall) goja.Value {
+	parts := make([]string, 0, len(call.Arguments))
+	for _, argument := range call.Arguments {
+		parts = append(parts, argument.String())
+	}
+	line := strings.Join(parts, " ")
+
+	if rt.truncated || rt.messageLen+len(line)+1 > balanceScriptMaxMessage {
+		rt.truncated = true
+		return goja.Undefined()
+	}
+	rt.lines = append(rt.lines, line)
+	rt.messageLen += len(line) + 1
+	return goja.Undefined()
+}
+
+func (rt *balanceScriptRuntime) stateGetRaw(call goja.FunctionCall) goja.Value {
+	return rt.vm.ToValue(rt.channel.BalanceScriptState)
+}
+
+func (rt *balanceScriptRuntime) stateGet(call goja.FunctionCall) goja.Value {
+	// Tolerate corrupt or double-encoded state by unwrapping JSON strings until a
+	// dict/list is obtained, falling back to an empty object.
+	raw := rt.channel.BalanceScriptState
+	var decoded any
+	for step := 0; step < balanceScriptStateUnwrap; step++ {
+		if raw == "" {
+			return rt.vm.NewObject()
+		}
+		if err := json.Unmarshal([]byte(raw), &decoded); err != nil {
+			return rt.vm.NewObject()
+		}
+		switch value := decoded.(type) {
+		case map[string]any, []any:
+			return rt.vm.ToValue(value)
+		case string:
+			raw = value
+		default:
+			return rt.vm.NewObject()
+		}
+	}
+	return rt.vm.NewObject()
+}
+
+func (rt *balanceScriptRuntime) stateSave(call goja.FunctionCall) goja.Value {
+	encoded, err := json.Marshal(call.Argument(0).Export())
+	if err != nil {
+		panic(rt.vm.NewTypeError("newapi.state.save() value is not JSON serializable: %s", err))
+	}
+	rt.setRawState(string(encoded))
+	return goja.Undefined()
+}
+
+func (rt *balanceScriptRuntime) stateSaveRaw(call goja.FunctionCall) goja.Value {
+	encoded, err := json.Marshal(call.Argument(0).String())
+	if err != nil {
+		panic(rt.vm.NewTypeError("newapi.state.saveRaw() value is not JSON serializable: %s", err))
+	}
+	rt.setRawState(string(encoded))
+	return goja.Undefined()
+}
+
+func (rt *balanceScriptRuntime) setRawState(encoded string) {
+	if len(encoded) > balanceScriptMaxStateLen {
+		panic(rt.vm.NewTypeError("balance script state exceeds %d bytes", balanceScriptMaxStateLen))
+	}
+	rt.state = encoded
+	rt.hasState = true
+}
+
+// balanceFetchOptions is the normalized argument of newapi.fetch().
+type balanceFetchOptions struct {
+	url     string
+	method  string
+	headers map[string]string
+	body    string
+}
+
+func (rt *balanceScriptRuntime) fetch(call goja.FunctionCall) goja.Value {
+	options, err := rt.parseFetchOptions(call.Argument(0))
+	if err != nil {
+		panic(rt.vm.NewTypeError("newapi.fetch(): %s", err))
+	}
+
+	if rt.fetches >= balanceScriptMaxFetches {
+		panic(rt.vm.NewTypeError("newapi.fetch() called more than %d times", balanceScriptMaxFetches))
+	}
+	rt.fetches++
+
+	status, headers, body, err := rt.doFetch(options)
+	if err != nil {
+		panic(rt.vm.NewTypeError("newapi.fetch(): %s", err))
+	}
+
+	result := rt.vm.NewObject()
+	_ = result.Set("status", status)
+	_ = result.Set("headers", headers)
+	_ = result.Set("body", body)
+	return result
+}
+
+func (rt *balanceScriptRuntime) parseFetchOptions(value goja.Value) (*balanceFetchOptions, error) {
+	options := &balanceFetchOptions{method: http.MethodGet, headers: map[string]string{}}
+
+	if stringValue, ok := value.Export().(string); ok {
+		options.url = stringValue
+	} else if object, ok := value.(*goja.Object); ok {
+		exported, _ := object.Export().(map[string]any)
+		if exported == nil {
+			return nil, fmt.Errorf("options must be an object or a URL string")
+		}
+		if raw, present := exported["url"]; present {
+			options.url = toString(raw)
+		}
+		if raw, present := exported["method"]; present {
+			options.method = strings.ToUpper(toString(raw))
+		}
+		if raw, present := exported["body"]; present {
+			options.body = toString(raw)
+		}
+		if raw, present := exported["headers"]; present {
+			headers, ok := raw.(map[string]any)
+			if !ok {
+				return nil, fmt.Errorf("headers must be an object")
+			}
+			for name, header := range headers {
+				options.headers[name] = toString(header)
+			}
+		}
+	} else {
+		return nil, fmt.Errorf("options must be an object or a URL string")
+	}
+
+	if strings.TrimSpace(options.url) == "" {
+		return nil, fmt.Errorf("url is required")
+	}
+	return options, nil
+}
+
+func (rt *balanceScriptRuntime) doFetch(options *balanceFetchOptions) (int, map[string]string, string, error) {
+	parsed, err := url.Parse(options.url)
+	if err != nil {
+		return 0, nil, "", fmt.Errorf("invalid url: %s", err)
+	}
+	if parsed.Scheme != "http" && parsed.Scheme != "https" {
+		return 0, nil, "", fmt.Errorf("unsupported scheme %q, only http and https are allowed", parsed.Scheme)
+	}
+
+	var body io.Reader
+	if options.body != "" {
+		body = strings.NewReader(options.body)
+	}
+	request, err := http.NewRequestWithContext(rt.ctx, options.method, options.url, body)
+	if err != nil {
+		return 0, nil, "", err
+	}
+	request.Header.Set("User-Agent", "new-api/balance-script")
+	for name, value := range options.headers {
+		request.Header.Set(name, value)
+	}
+
+	client := &http.Client{
+		Transport: &http.Transport{
+			Proxy:                 nil,
+			DialContext:           balanceScriptDialContext,
+			TLSHandshakeTimeout:   balanceScriptFetchTimeout,
+			ResponseHeaderTimeout: balanceScriptFetchTimeout,
+		},
+		Timeout: balanceScriptFetchTimeout,
+		CheckRedirect: func(request *http.Request, via []*http.Request) error {
+			if len(via) >= balanceScriptMaxRedirects {
+				return fmt.Errorf("stopped after %d redirects", balanceScriptMaxRedirects)
+			}
+			return nil
+		},
+	}
+
+	response, err := client.Do(request)
+	if err != nil {
+		return 0, nil, "", err
+	}
+	defer response.Body.Close()
+
+	payload, err := io.ReadAll(io.LimitReader(response.Body, balanceScriptMaxBodyLen+1))
+	if err != nil {
+		return 0, nil, "", err
+	}
+	if len(payload) > balanceScriptMaxBodyLen {
+		return 0, nil, "", fmt.Errorf("response body exceeds %d bytes", balanceScriptMaxBodyLen)
+	}
+
+	headers := make(map[string]string, len(response.Header))
+	for name := range response.Header {
+		headers[name] = response.Header.Get(name)
+	}
+
+	return response.StatusCode, headers, string(payload), nil
+}
+
+// balanceScriptDialContext dials only public addresses, so a script cannot reach
+// loopback, private or link-local services of the host it runs on.
+func balanceScriptDialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, err
+	}
+
+	addresses, err := net.DefaultResolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	if len(addresses) == 0 {
+		return nil, fmt.Errorf("no address found for %s", host)
+	}
+
+	dialer := &net.Dialer{Timeout: balanceScriptFetchTimeout}
+	var lastErr error
+	for _, candidate := range addresses {
+		if isBlockedBalanceScriptIP(candidate.IP) {
+			lastErr = fmt.Errorf("address %s is not allowed", candidate.IP)
+			continue
+		}
+		// Dial the resolved address directly so a DNS answer cannot change between
+		// the check and the connection.
+		connection, err := dialer.DialContext(ctx, network, net.JoinHostPort(candidate.IP.String(), port))
+		if err == nil {
+			return connection, nil
+		}
+		lastErr = err
+	}
+	if lastErr == nil {
+		lastErr = fmt.Errorf("unable to connect to %s", host)
+	}
+	return nil, lastErr
+}
+
+func isBlockedBalanceScriptIP(ip net.IP) bool {
+	return ip.IsLoopback() ||
+		ip.IsPrivate() ||
+		ip.IsLinkLocalUnicast() ||
+		ip.IsLinkLocalMulticast() ||
+		ip.IsInterfaceLocalMulticast() ||
+		ip.IsMulticast() ||
+		ip.IsUnspecified()
+}
+
+// toString converts an exported goja value into a string without producing
+// JS-style "[object Object]" noise for nil.
+func toString(value any) string {
+	if value == nil {
+		return ""
+	}
+	if text, ok := value.(string); ok {
+		return text
+	}
+	return fmt.Sprint(value)
+}
