+import { CircleHelp } from 'lucide-react'
+import type { Control, FieldPath, FieldValues } from 'react-hook-form'
+import { useTranslation } from 'react-i18next'
+
+import { Dialog } from '@/components/dialog'
+import { Button } from '@/components/ui/button'
+import {
+  FormControl,
+  FormField,
+  FormItem,
+  FormLabel,
+  FormMessage,
+} from '@/components/ui/form'
+import { Textarea } from '@/components/ui/textarea'
+
+const BALANCE_SCRIPT_TEMPLATE = `const url = newapi.environ.CHANNEL_BASE_URL + "/v1/user/balance";
+const resp = newapi.fetch({
+  url: url,
+  headers: { Authorization: "Bearer " + newapi.environ.CHANNEL_KEY },
+});
+const data = JSON.parse(resp.body);
+
+newapi.balance.set(data.balance);
+// State survives between runs; get() returns {} on the first run.
+newapi.state.save(newapi.state.get());
+newapi.debug.log("Balance: " + data.balance);
+`
+
+interface BalanceScriptFieldProps<TFieldValues extends FieldValues> {
+  control: Control<TFieldValues>
+  name: FieldPath<TFieldValues>
+}
+
+export function BalanceScriptField<TFieldValues extends FieldValues>({
+  control,
+  name,
+}: BalanceScriptFieldProps<TFieldValues>) {
+  const { t } = useTranslation()
+
+  return (
+    <FormField
+      control={control}
+      name={name}
+      render={({ field }) => (
+        <FormItem className='space-y-3'>
+          <div className='flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between'>
+            <div className='flex items-center gap-2'>
+              <FormLabel>{t('Custom Balance Script (JavaScript)')}</FormLabel>
+              <Dialog
+                title={t('Balance Script Guide')}
+                description={t(
+                  'Use a sandboxed JavaScript script to query an upstream balance and return an optional status message.'
+                )}
+                trigger={
+                  <Button
+                    type='button'
+                    variant='ghost'
+                    size='icon-sm'
+                    aria-label={t('Balance script guide')}
+                    title={t('Balance script guide')}
+                  >
+                    <CircleHelp className='size-4' />
+                  </Button>
+                }
+              >
+                <div className='space-y-4 text-sm'>
+                  <section className='space-y-2'>
+                    <h3 className='font-medium'>
+                      {t('Environment variables')}
+                    </h3>
+                    <pre className='bg-muted/50 rounded-md border p-3 text-xs whitespace-pre-wrap'>
+                      {`newapi.environ:
+CHANNEL_BASE_URL: channel API base URL
+CHANNEL_KEY: API key; multiple keys are joined with commas
+CHANNEL_TYPE: channel type ID (string)
+CHANNEL_ID: channel ID (string)
+CHANNEL_IS_MULTI_KEY: "1" for multiple keys, otherwise "0"`}
+                    </pre>
+                  </section>
+                  <section className='space-y-2'>
+                    <h3 className='font-medium'>{t('Script API')}</h3>
+                    <pre className='bg-muted/50 overflow-x-auto rounded-md border p-3 text-xs whitespace-pre-wrap'>
+                      {`const saved = newapi.state.get() // {} on the first run
+newapi.balance.set(12.34)
+newapi.state.save(saved)
+newapi.debug.log("Balance: $12.34")
+newapi.debug.log("Weekly: $5.00")
+
+const resp = newapi.fetch({ url, method, headers, body })
+// -> { status, headers, body }; http(s) only, 1 MiB body cap`}
+                    </pre>
+                  </section>
+                  <section className='space-y-2'>
+                    <h3 className='font-medium'>
+                      {t('Return values and limits')}
+                    </h3>
+                    <p className='text-muted-foreground'>
+                      Use Fill Template for a newapi.fetch() HTTP example;
+                      adjust its endpoint and JSON balance field for your
+                      provider. balance.set() sets the numeric result;
+                      state.get()/save() persists JSON between runs. debug.log()
+                      returns a message; multiple calls are shown on separate
+                      lines. Scripts run on a JavaScript engine without file,
+                      process or socket access: newapi.fetch() is the only way
+                      out, http(s) only. A run is limited to 30 seconds, 16
+                      fetches, a 1 MiB response body, 72 KiB of messages and
+                      64 KiB of saved state. Leave the editor empty to use the
+                      default balance API.
+                    </p>
+                  </section>
+                </div>
+              </Dialog>
+            </div>
+            <div className='flex flex-wrap gap-2'>
+              <Button
+                type='button'
+                variant='outline'
+                size='sm'
+                onClick={() => field.onChange(BALANCE_SCRIPT_TEMPLATE)}
+              >
+                {t('Fill Template')}
+              </Button>
+              <Button
+                type='button'
+                variant='ghost'
+                size='sm'
+                onClick={() => field.onChange('')}
+              >
+                {t('Clear')}
+              </Button>
+            </div>
+          </div>
+          <FormControl>
+            <Textarea
+              {...field}
+              rows={10}
+              className='font-mono text-xs'
+              placeholder={t('Leave empty to use the default balance API')}
+            />
+          </FormControl>
+          <FormMessage />
+        </FormItem>
+      )}
+    />
+  )
+}
