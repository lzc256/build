+test('balance script has a separate tab and opens its environment guide', async () => {
+  const user = userEvent.setup()
+  render(<ConfigurationHarness currentRow={editingChannel} />)
+  expect(await screen.findByDisplayValue('Existing channel')).toBeVisible()
+  expect(
+    screen.queryByLabelText('Custom Balance Script (JavaScript)')
+  ).not.toBeVisible()
+  await user.click(screen.getByRole('tab', { name: /Balance Script/ }))
+  const script = screen.getByLabelText('Custom Balance Script (JavaScript)')
+  expect(script).toBeVisible()
+  expect(
+    screen.queryByText('CHANNEL_BASE_URL: channel API base URL')
+  ).not.toBeInTheDocument()
+  await user.click(screen.getByRole('button', { name: 'Balance script guide' }))
+  const guide = screen.getByRole('dialog', { name: 'Balance Script Guide' })
+  expect(
+    within(guide).getByText(/CHANNEL_BASE_URL: channel API base URL/)
+  ).toBeVisible()
+  expect(within(guide).getByText(/newapi\.fetch\(\) is the only way out/)).toBeVisible()
+  await user.click(within(guide).getByRole('button', { name: 'Close' }))
+  fireEvent.change(script, { target: { value: 'newapi.balance.set(1)' } })
+  await user.click(screen.getByRole('tab', { name: /Connection & Models/ }))
+  await user.click(screen.getByRole('tab', { name: /Balance Script/ }))
+  expect(script).toHaveValue('newapi.balance.set(1)')
+})
