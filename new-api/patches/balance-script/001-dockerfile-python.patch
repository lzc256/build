From 75ee374e63a75d057ffe7a308a12ad1dadfa99b8 Mon Sep 17 00:00:00 2001
From: lzc256 <i@lzc256.com>
Date: Fri, 17 Jul 2026 14:30:56 +0800
Subject: [PATCH] feat: install Python and RestrictedPython in Dockerfile

- Add python3, python3-pip, python3-seccomp packages
- Install RestrictedPython via pip
- Required for balance script execution
---
 Dockerfile | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Dockerfile b/Dockerfile
index e2788f5..6dfc965 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -42,6 +42,8 @@ FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0
 
 RUN apt-get update \
     && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 wget \
+       python3 python3-pip python3-seccomp \
+    && pip install --break-system-packages RestrictedPython \
     && rm -rf /var/lib/apt/lists/* \
     && update-ca-certificates
 
