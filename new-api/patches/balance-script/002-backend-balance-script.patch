diff --git a/controller/channel_balance_script.go b/controller/channel_balance_script.go
new file mode 100644
index 0000000..8e5e4a4
--- /dev/null
+++ b/controller/channel_balance_script.go
@@ -0,0 +1,400 @@
+package controller
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os/exec"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/QuantumNous/new-api/model"
+)
+
+const (
+	balanceScriptTimeout      = 30 * time.Second
+	balanceScriptMaxOutputLen = 72 * 1024         // 72KB cap on script stdout/stderr (extra room for state JSON)
+	balanceScriptMemoryLimit  = 128 * 1024 * 1024 // 128MB virtual address space
+	balanceScriptCPULimit     = 25                // 25s CPU time (wall clock is 30s)
+	balanceScriptNprocLimit   = 64                // max processes/threads
+	balanceScriptMaxStateLen  = 65536             // 64KB max state size
+)
+
+// updateChannelBalanceScript executes a user-defined Python script to fetch channel balance.
+// The script receives channel info via environment variables:
+//   - CHANNEL_BASE_URL: the channel's base URL
+//   - CHANNEL_KEY: the channel's API key (for multi-key channels: all keys joined by ",")
+//   - CHANNEL_TYPE: the channel type integer
+//   - CHANNEL_ID: the channel ID
+//   - CHANNEL_IS_MULTI_KEY: "1" if multi-key, "0" otherwise
+//   - CHANNEL_STATE: previous state (empty on first run)
+//   - BALANCE_SCRIPT_SOURCE: the user script source code
+//
+// The script must print to stdout:
+//   - JSON object: {"balance": <number>, "state": <any json value>}
+//   - Or a single number (backward compatible, state unchanged)
+//
+// Security layers:
+//  1. RestrictedPython: compile_restricted + safe_builtins + safer_getattr + import whitelist
+//  2. seccomp: allow read-only open + network, deny write/execve/fork
+//  3. prlimit: CPU/memory/process limits
+//  4. env whitelist: only CHANNEL_* + minimal PATH/HOME/LANG
+func updateChannelBalanceScript(channel *model.Channel, script string) (float64, string, error) {
+	// Acquire per-channel lock to serialize state read/write
+	lock := model.GetChannelPollingLock(channel.Id)
+	lock.Lock()
+	defer lock.Unlock()
+
+	ctx, cancel := context.WithTimeout(context.Background(), balanceScriptTimeout)
+	defer cancel()
+
+	// For multi-key channels, join all keys with ","; otherwise use the single key.
+	keyEnv := channel.Key
+	isMultiKey := "0"
+	if channel.ChannelInfo.IsMultiKey {
+		keyEnv = strings.Join(channel.GetKeys(), ",")
+		isMultiKey = "1"
+	}
+
+	// Build env whitelist (do NOT inherit os.Environ() to avoid leaking secrets)
+	cmdEnv := []string{
+		"PATH=/usr/bin:/bin",
+		"HOME=/nonexistent",
+		"LANG=C.UTF-8",
+		"PYTHONNOUSERSITE=1",
+		"PYTHONDONTWRITEBYTECODE=1",
+		"CHANNEL_BASE_URL=" + channel.GetBaseURL(),
+		"CHANNEL_KEY=" + keyEnv,
+		"CHANNEL_TYPE=" + strconv.Itoa(channel.Type),
+		"CHANNEL_ID=" + strconv.Itoa(channel.Id),
+		"CHANNEL_IS_MULTI_KEY=" + isMultiKey,
+		"CHANNEL_STATE=" + channel.BalanceScriptState,
+		"BALANCE_SCRIPT_SOURCE=" + script,
+	}
+
+	// prlimit applies RLIMIT_* before exec; child python3 inherits the limits.
+	cmd := exec.CommandContext(ctx, "prlimit",
+		fmt.Sprintf("--as=%d", balanceScriptMemoryLimit),
+		fmt.Sprintf("--cpu=%d", balanceScriptCPULimit),
+		fmt.Sprintf("--nproc=%d", balanceScriptNprocLimit),
+		"--", "python3", "-I", "-c", balanceScriptHarness)
+	cmd.Env = cmdEnv
+	// Run in its own process group so we can kill any subprocesses on timeout.
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+
+	// Cap stdout/stderr so a runaway print doesn't blow up our memory.
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &limitWriter{w: &stdout, n: balanceScriptMaxOutputLen}
+	cmd.Stderr = &limitWriter{w: &stderr, n: balanceScriptMaxOutputLen}
+
+	if err := cmd.Start(); err != nil {
+		return 0, "", fmt.Errorf("balance script start failed: %w", err)
+	}
+
+	// On context timeout, signal the whole process group (negative pid).
+	done := make(chan error, 1)
+	go func() { done <- cmd.Wait() }()
+
+	var waitErr error
+	select {
+	case <-ctx.Done():
+		_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
+		<-done
+		return 0, "", fmt.Errorf("balance script timed out after %s", balanceScriptTimeout)
+	case waitErr = <-done:
+	}
+
+	if waitErr != nil {
+		var exitErr *exec.ExitError
+		if errors.As(waitErr, &exitErr) {
+			return 0, "", fmt.Errorf("balance script error: %s", strings.TrimSpace(stderr.String()))
+		}
+		return 0, "", waitErr
+	}
+
+	// Parse output: JSON object or plain number
+	output := strings.TrimSpace(stdout.String())
+	if strings.HasPrefix(output, "{") {
+		var result struct {
+			Balance float64         `json:"balance"`
+			State   json.RawMessage `json:"state"`
+			Message string          `json:"message"`
+		}
+		if err := json.Unmarshal([]byte(output), &result); err != nil {
+			return 0, "", fmt.Errorf("balance script invalid JSON: %w, output: %s", err, output)
+		}
+		if len(result.State) > balanceScriptMaxStateLen {
+			return 0, "", fmt.Errorf("balance script state exceeds %d bytes", balanceScriptMaxStateLen)
+		}
+		// Atomic update: write state first, then balance
+		if err := channel.UpdateBalanceScriptState(string(result.State)); err != nil {
+			return 0, "", fmt.Errorf("failed to save balance script state: %w", err)
+		}
+		channel.UpdateBalance(result.Balance)
+		return result.Balance, result.Message, nil
+	}
+
+	// Backward compatible: plain number output, state unchanged
+	balance, err := strconv.ParseFloat(output, 64)
+	if err != nil {
+		return 0, "", fmt.Errorf("balance script output invalid (expected number or JSON): %s", output)
+	}
+	channel.UpdateBalance(balance)
+	return balance, "", nil
+}
+
+// limitWriter writes to w until n bytes have been written, then silently discards the rest.
+type limitWriter struct {
+	w io.Writer
+	n int64
+}
+
+func (lw *limitWriter) Write(p []byte) (int, error) {
+	if lw.n <= 0 {
+		return len(p), nil
+	}
+	if int64(len(p)) > lw.n {
+		_, err := lw.w.Write(p[:lw.n])
+		lw.n = 0
+		if err != nil {
+			return 0, err
+		}
+		return len(p), nil
+	}
+	n, err := lw.w.Write(p)
+	lw.n -= int64(n)
+	return n, err
+}
+
+// balanceScriptHarness is the trusted Python wrapper that runs the user script.
+// It enforces RestrictedPython + seccomp before executing untrusted code.
+//
+// User scripts MUST use the newapi module to communicate results:
+//
+//	from newapi import environ, state, balance
+//	prev = state.get() or {}
+//	state.save({"token": new_token})
+//	balance.set(123.45)
+//
+// print() is disabled. Use stderr for debugging if needed.
+const balanceScriptHarness = `
+import os, json, sys
+
+# Read channel inputs before seccomp filter is installed.
+_channel_env = {
+    'CHANNEL_BASE_URL':     os.environ.get('CHANNEL_BASE_URL', ''),
+    'CHANNEL_KEY':          os.environ.get('CHANNEL_KEY', ''),
+    'CHANNEL_TYPE':         os.environ.get('CHANNEL_TYPE', ''),
+    'CHANNEL_ID':           os.environ.get('CHANNEL_ID', ''),
+    'CHANNEL_IS_MULTI_KEY': os.environ.get('CHANNEL_IS_MULTI_KEY', ''),
+}
+_channel_state_raw = os.environ.get('CHANNEL_STATE', '')
+_user_script = os.environ.get('BALANCE_SCRIPT_SOURCE', '')
+
+# Pre-import all allowed modules BEFORE seccomp filter is installed.
+import urllib, urllib.request, urllib.parse, urllib.error
+import math, datetime, re, base64, hashlib, hmac
+import time, ssl, socket, http
+import collections, itertools, functools, string
+import random, secrets, uuid, decimal
+
+# RestrictedPython
+from RestrictedPython import compile_restricted, safe_builtins
+from RestrictedPython.Guards import safer_getattr, guarded_iter_unpack_sequence, guarded_unpack_sequence
+from RestrictedPython.Eval import default_guarded_getiter
+
+# Install seccomp filter before executing user code.
+try:
+    from seccomp import SyscallFilter, Action, Arg
+    O_ACCMODE = 3
+    f = SyscallFilter(def_action=Action.ERRNO(1))
+    for s in [
+        'read', 'write', 'close', 'mmap', 'mprotect', 'munmap', 'brk',
+        'rt_sigaction', 'rt_sigprocmask', 'rt_sigreturn', 'ioctl',
+        'poll', 'ppoll', 'pselect6', 'nanosleep', 'clock_gettime', 'clock_nanosleep',
+        'stat', 'lstat', 'newfstatat', 'readlink', 'readlinkat', 'getcwd',
+        'access', 'faccessat', 'fcntl', 'dup', 'dup2', 'dup3',
+        'getrandom', 'futex', 'prlimit64', 'arch_prctl', 'rseq',
+        'set_tid_address', 'set_robust_list', 'madvise', 'sched_yield',
+        'getpid', 'gettid', 'getuid', 'geteuid', 'getgid', 'getegid',
+        'socket', 'connect', 'bind', 'listen', 'accept', 'accept4',
+        'sendto', 'recvfrom', 'sendmsg', 'recvmsg', 'shutdown',
+        'setsockopt', 'getsockopt', 'getsockname', 'getpeername',
+        'uname', 'sysinfo', 'getdents64', 'pread64', 'pwrite64',
+    ]:
+        f.add_rule(Action.ALLOW, s)
+    f.add_rule(Action.ALLOW, 'openat', [Arg(2, 'masked_eq', O_ACCMODE, 0)])
+    f.add_rule(Action.ERRNO(1), 'openat')
+    f.add_rule(Action.ALLOW, 'open', [Arg(1, 'masked_eq', O_ACCMODE, 0)])
+    f.add_rule(Action.ERRNO(1), 'open')
+    f.load()
+except Exception:
+    pass
+
+# --------------------------------------------------------------------------
+# newapi module: the only interface user scripts should use.
+# --------------------------------------------------------------------------
+
+class _State:
+    _raw = _channel_state_raw
+    _saved = None  # None = not saved; otherwise the raw object/string to be JSON-encoded
+
+    @staticmethod
+    def get():
+        # Defensive: tolerate corrupt or double-encoded state by unwrapping
+        # JSON strings until a dict/list is obtained, falling back to {}.
+        raw = _State._raw
+        if not raw:
+            return {}
+        for _ in range(8):
+            try:
+                val = json.loads(raw)
+            except Exception:
+                return {}
+            if isinstance(val, (dict, list)):
+                return val
+            if isinstance(val, str):
+                raw = val  # double-encoded JSON string -> unwrap once more
+                continue
+            return {}
+        return {}
+
+    @staticmethod
+    def getRaw():
+        return _State._raw
+
+    @staticmethod
+    def save(obj):
+        _State._saved = obj  # store object; json.dumps(out) serializes once
+
+    @staticmethod
+    def saveRaw(s):
+        _State._saved = str(s)  # store string; json.dumps encodes as JSON string value
+
+class _Balance:
+    _value = None
+
+    @staticmethod
+    def set(value):
+        _Balance._value = float(value)
+
+class _Debug:
+    _lines = []
+    @staticmethod
+    def log(*args, **kwargs):
+        msg = ' '.join(str(a) for a in args)
+        _Debug._lines.append(msg)
+        print(msg, file=sys.stderr)
+
+# Register the synthetic newapi module.
+import types as _types
+_newapi_mod = _types.ModuleType('newapi')
+_newapi_mod.environ = _channel_env
+_newapi_mod.state = _State
+_newapi_mod.balance = _Balance
+_newapi_mod.debug = _Debug
+sys.modules['newapi'] = _newapi_mod
+
+# Disable print in user scripts. RestrictedPython rewrites print(x) to:
+#   _print = _print_(_getattr_)   # constructor call
+#   _print._call_print(x)         # method call
+# So _print_ must be a callable returning an object with _call_print.
+def _disabled_print_call(*args, **kwargs):
+    raise RuntimeError("print() is disabled in balance scripts; use newapi.debug.log() for debugging")
+
+class _DisabledPrint:
+    def __new__(cls, *args, **kwargs):
+        return _DisabledPrint
+    @staticmethod
+    def _call_print(*args, **kwargs):
+        raise RuntimeError("print() is disabled in balance scripts; use newapi.debug.log() for debugging")
+
+ALLOWED_MODS = {
+    'urllib', 'urllib.request', 'urllib.parse', 'urllib.error',
+    'json', 'math', 'datetime', 're', 'base64', 'hashlib', 'hmac',
+    'time', 'ssl', 'socket', 'http', 'collections', 'itertools',
+    'functools', 'string', 'random', 'secrets', 'uuid', 'decimal',
+    'newapi',
+}
+
+def _safe_import(name, g=None, l=None, ff=(), level=0):
+    root = name.split('.')[0]
+    if root not in ALLOWED_MODS:
+        raise ImportError("module '%s' is not allowed" % name)
+    return __builtins__.__import__(name, g, l, ff, level)
+
+b = dict(safe_builtins)
+b['__import__'] = _safe_import
+
+# Guard for inplace operations (x += 1, x -= 1, etc.)
+# RestrictedPython rewrites 'x += y' to 'x = _inplacevar_("+=", x, y)'
+def _inplacevar_(op, obj, val):
+    if op == '+=': return obj + val
+    if op == '-=': return obj - val
+    if op == '*=': return obj * val
+    if op == '/=': return obj / val
+    if op == '//=': return obj // val
+    if op == '%=': return obj % val
+    if op == '**=': return obj ** val
+    if op == '<<=': return obj << val
+    if op == '>>=': return obj >> val
+    if op == '&=': return obj & val
+    if op == '|=': return obj | val
+    if op == '^=': return obj ^ val
+    raise TypeError(f"unsupported inplace operator: {op}")
+
+b['_inplacevar_'] = _inplacevar_
+
+# RestrictedPython's safe_builtins omits basic Python types; add them back
+_builtins_dict = __builtins__ if isinstance(__builtins__, dict) else __builtins__.__dict__
+for _name in ('dict', 'list', 'tuple', 'set', 'frozenset',
+              'int', 'float', 'str', 'bytes', 'bytearray', 'bool',
+              'None', 'True', 'False', 'type', 'object',
+              'len', 'range', 'enumerate', 'zip', 'sorted', 'reversed',
+              'min', 'max', 'sum', 'abs', 'round', 'pow', 'divmod',
+              'isinstance', 'issubclass', 'hasattr', 'getattr', 'setattr', 'delattr',
+              'KeyError', 'ValueError', 'TypeError', 'AttributeError',
+              'IndexError', 'StopIteration', 'RuntimeError', 'Exception',
+              'ArithmeticError', 'ZeroDivisionError', 'OverflowError',
+              'AssertionError', 'ImportError', 'LookupError', 'NameError',
+              'OSError', 'IOError', 'FileNotFoundError'):
+    if _name in _builtins_dict:
+        b[_name] = _builtins_dict[_name]
+
+g = {
+    '__builtins__': b,
+    '__metaclass__': type,
+    '__name__': '__main__',
+    '_getattr_': safer_getattr,
+    '_getitem_': lambda o, k: o[k],
+    '_write_': lambda o: o,
+    '_getiter_': default_guarded_getiter,
+    '_iter_unpack_sequence_': guarded_iter_unpack_sequence,
+    '_unpack_sequence_': guarded_unpack_sequence,
+    '_print_': _DisabledPrint,
+}
+
+try:
+    code = compile_restricted(_user_script, '<balance_script>', 'exec')
+    exec(code, g)
+except Exception as e:
+    sys.stderr.write(json.dumps({"error": str(e)}) + "\n")
+    raise SystemExit(1)
+
+# Output result
+if _Balance._value is None:
+    sys.stderr.write(json.dumps({"error": "balance.set() was never called"}) + "\n")
+    raise SystemExit(1)
+
+out = {"balance": _Balance._value}
+if _State._saved is not None:
+    out["state"] = _State._saved
+if _Debug._lines:
+    out["message"] = "\n".join(_Debug._lines)
+sys.stdout.write(json.dumps(out))
+`
