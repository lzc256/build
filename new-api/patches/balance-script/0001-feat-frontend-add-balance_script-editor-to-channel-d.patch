++package controller
++
++import (
++	"context"
++	"fmt"
++	"os"
++	"os/exec"
++	"strconv"
++	"strings"
++	"time"
++
++	"github.com/QuantumNous/new-api/model"
++)
++
++// updateChannelBalanceScript executes a user-defined Python script to fetch channel balance.
++// The script receives channel info via environment variables:
++//   - CHANNEL_BASE_URL: the channel's base URL
++//   - CHANNEL_KEY: the channel's API key
++//   - CHANNEL_TYPE: the channel type integer
++//   - CHANNEL_ID: the channel ID
++//
++// The script must print a single number to stdout (the balance value).
++// Only Python standard library is available (urllib.request, json, os, etc.).
++// Execution timeout is 30 seconds.
++//
++// Example script:
++//
++//	import urllib.request, json, os
++//	url = os.environ["CHANNEL_BASE_URL"] + "/v1/user/balance"
++//	req = urllib.request.Request(url, headers={"Authorization": "Bearer " + os.environ["CHANNEL_KEY"]})
++//	with urllib.request.urlopen(req, timeout=15) as resp:
++//	    data = json.loads(resp.read())
++//	print(data["balance"])
++func updateChannelBalanceScript(channel *model.Channel, script string) (float64, error) {
++	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
++	defer cancel()
++
++	cmd := exec.CommandContext(ctx, "python3", "-c", script)
++	cmd.Env = append(os.Environ(),
++		"CHANNEL_BASE_URL="+channel.GetBaseURL(),
++		"CHANNEL_KEY="+channel.Key,
++		"CHANNEL_TYPE="+strconv.Itoa(channel.Type),
++		"CHANNEL_ID="+strconv.Itoa(channel.Id),
++	)
++
++	output, err := cmd.Output()
++	if err != nil {
++		if exitErr, ok := err.(*exec.ExitError); ok {
++			return 0, fmt.Errorf("balance script error: %s", string(exitErr.Stderr))
++		}
++		return 0, err
++	}
++
++	balance, err := strconv.ParseFloat(strings.TrimSpace(string(output)), 64)
++	if err != nil {
++		return 0, fmt.Errorf("balance script output invalid (expected number): %s", string(output))
++	}
++	channel.UpdateBalance(balance)
++	return balance, nil
++}
