+              >
+                {t('Fill Template')}
+              </Button>
+              <Button
+                type='button'
+                variant='ghost'
+                size='sm'
+                onClick={() => field.onChange('')}
+              >
+                {t('Clear')}
+              </Button>
+            </div>
+          </div>
+          <FormControl>
+            <Textarea
+              {...field}
+              rows={10}
+              className='font-mono text-xs'
+              placeholder={t('Leave empty to use the default balance API')}
+            />
+          </FormControl>
+          <FormMessage />
+        </FormItem>
+      )}
+    />
+  )
+}
