+import { useTranslation } from 'react-i18next'
+import { Button } from '@/components/ui/button'
+import { Textarea } from '@/components/ui/textarea'
+import {
+  FormControl,
+  FormDescription,
+  FormItem,
+  FormLabel,
+  FormMessage,
+} from '@/components/ui/form'
+import type { FieldPath, FieldValues } from 'react-hook-form'
+import type { Control } from 'react-hook-form'
+import { FormField } from '@/components/ui/form'
+
+const BALANCE_SCRIPT_TEMPLATE = `import urllib.request, json
+from newapi import environ, state, balance
+
+url = environ["CHANNEL_BASE_URL"] + "/v1/user/balance"
+req = urllib.request.Request(url, headers={
+    "Authorization": "Bearer " + environ["CHANNEL_KEY"]
+})
+with urllib.request.urlopen(req, timeout=15) as resp:
+    data = json.loads(resp.read())
+
+balance.set(data["balance"])
+# Save state (state.get() returns {} on first run)
+s = state.get()
+state.save(s)
+`
+
+interface BalanceScriptFieldProps<TFieldValues extends FieldValues> {
+  control: Control<TFieldValues>
+  name: FieldPath<TFieldValues>
+}
+
+export function BalanceScriptField<TFieldValues extends FieldValues>({
+  control,
+  name,
+}: BalanceScriptFieldProps<TFieldValues>) {
+  const { t } = useTranslation()
+
+  return (
+    <FormField
+      control={control}
+      name={name}
+      render={({ field }) => (
+        <FormItem className='space-y-3 border-t pt-4'>
+          <div className='flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between'>
+            <div className='space-y-1'>
+              <FormLabel>{t('Custom Balance Script (Python)')}</FormLabel>
+              <FormDescription>
+                {t(
+                  'Python script to fetch channel balance. Stdlib only. Use newapi.environ for inputs, newapi.state.get()/save() for state, newapi.balance.set() for result.'
+                )}
+              </FormDescription>
+            </div>
+            <div className='flex flex-wrap gap-2'>
+              <Button
+                type='button'
+                variant='outline'
+                size='sm'
+                onClick={() => field.onChange(BALANCE_SCRIPT_TEMPLATE)}
+              >
+                {t('Fill Template')}
+              </Button>
+              <Button
+                type='button'
+                variant='ghost'
+                size='sm'
+                onClick={() => field.onChange('')}
+              >
+                {t('Clear')}
+              </Button>
+            </div>
+          </div>
+          <FormControl>
+            <Textarea
+              {...field}
+              rows={10}
+              className='font-mono text-xs'
+              placeholder={t('Leave empty to use the default balance API')}
+            />
+          </FormControl>
+          <FormMessage />
+        </FormItem>
+      )}
+    />
+  )
+}
