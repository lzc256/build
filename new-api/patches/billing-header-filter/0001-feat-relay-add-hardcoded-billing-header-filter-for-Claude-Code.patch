Date: Thu, 18 Jun 2026 11:03:06 +0800
Subject: [PATCH] feat(relay): add hardcoded billing header filter for Claude
 Code

- Strip x-anthropic-billing-header from all JSON string fields
- Only matches strings that START with the header (no false positives)
- Regex: x-anthropic-billing-header:.*?cch=[^;]*;?
- Logs info when header stripped, info if still present after (unexpected)
- Applies to ALL channels, cannot be disabled from admin panel
- Execution order: RemoveDisabledFields -> ApplyBuiltinOverride -> ApplyParamOverrideWithRelayInfo
---
 relay/claude_handler.go          |  6 ++++
 relay/common/builtin_override.go | 54 ++++++++++++++++++++++++++++++++
 relay/compatible_handler.go      |  6 ++++
 3 files changed, 66 insertions(+)
 create mode 100644 relay/common/builtin_override.go

diff --git a/relay/claude_handler.go b/relay/claude_handler.go
index 52736320..5e05fcc7 100644
--- a/relay/claude_handler.go
+++ b/relay/claude_handler.go
@@ -174,6 +174,12 @@ func ClaudeHelper(c *gin.Context, info *relaycommon.RelayInfo) (newAPIError *typ
 			return types.NewError(err, types.ErrorCodeConvertRequestFailed, types.ErrOptionWithSkipRetry())
 		}
 
+		// Apply builtin override (hardcoded billing header filter)
+		jsonData, err = relaycommon.ApplyBuiltinOverride(jsonData)
+		if err != nil {
+			return types.NewError(err, types.ErrorCodeConvertRequestFailed, types.ErrOptionWithSkipRetry())
+		}
+
 		// apply param override
 		if len(info.ParamOverride) > 0 {
 			jsonData, err = relaycommon.ApplyParamOverrideWithRelayInfo(jsonData, info)
diff --git a/relay/common/builtin_override.go b/relay/common/builtin_override.go
new file mode 100644
index 00000000..137f852c
--- /dev/null
+++ b/relay/common/builtin_override.go
@@ -0,0 +1,54 @@
+package common
+
+import (
+	"bytes"
+	"regexp"
+	"strings"
+
+	"github.com/QuantumNous/new-api/logger"
+)
+
+// billingHeaderRegex matches: x-anthropic-billing-header: ... cch=...;
+var billingHeaderRegex = regexp.MustCompile(`x-anthropic-billing-header:.*?cch=[^;]*;?`)
+
+// jsonStringValueRegex matches JSON string values: "..."
+var jsonStringValueRegex = regexp.MustCompile(`"([^"\\]*(\\.[^"\\]*)*)"`)
+
+// ApplyBuiltinOverride strips Claude Code billing headers from all string fields in the request body.
+// This is a hardcoded filter that applies to ALL channels and cannot be disabled from the admin panel.
+func ApplyBuiltinOverride(jsonData []byte) ([]byte, error) {
+	// Fast path: skip if no billing header present
+	if !bytes.Contains(jsonData, []byte("x-anthropic-billing-header")) {
+		return jsonData, nil
+	}
+
+	// Replace all string values that start with the billing header
+	result := jsonStringValueRegex.ReplaceAllFunc(jsonData, func(match []byte) []byte {
+		// match = "..." including quotes
+		if len(match) < 2 {
+			return match
+		}
+		inner := string(match[1 : len(match)-1]) // strip quotes
+
+		// Only process if starts with billing header
+		if !strings.HasPrefix(inner, "x-anthropic-billing-header:") {
+			return match
+		}
+
+		// Strip the billing header part only
+		cleaned := billingHeaderRegex.ReplaceAllString(inner, "")
+		return []byte(`"` + cleaned + `"`)
+	})
+
+	// Log debug if header was stripped
+	if !bytes.Equal(jsonData, result) {
+		logger.LogDebug(nil, "stripped x-anthropic-billing-header from request")
+	}
+
+	// Log warn if header still present after stripping (unexpected)
+	if bytes.Contains(result, []byte("x-anthropic-billing-header")) {
+		logger.LogInfo(nil, "[warn] x-anthropic-billing-header still present after stripping, check regex pattern")
+	}
+
+	return result, nil
+}
