+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/setting/system_setting"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// A secondary domain must not answer differently from a stock instance whose
+// providers are not configured: any dedicated code, status or hint would reveal
+// that another, hidden address exists.
+func TestSecondaryDomainLoginRejectionsLookLikeUnconfiguredFeatures(t *testing.T) {
+	previousAddress := system_setting.ServerAddress
+	previousWeChat := common.WeChatAuthEnabled
+	previousOptionMap := common.OptionMap
+	t.Cleanup(func() {
+		system_setting.ServerAddress = previousAddress
+		common.WeChatAuthEnabled = previousWeChat
+		common.OptionMap = previousOptionMap
+	})
+	system_setting.ServerAddress = "https://panel.example.com"
+	common.OptionMap = map[string]string{}
+
+	secondary := func(method, target, body string, handler gin.HandlerFunc) *httptest.ResponseRecorder {
+		response := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(response)
+		c.Request = httptest.NewRequest(method, target, strings.NewReader(body))
+		c.Request.Header.Set("Content-Type", "application/json")
+		c.Params = gin.Params{{Key: "provider", Value: "oidc"}}
+		handler(c)
+		return response
+	}
+
+	// Unknown provider: same body, same status, no trace of this patch.
+	t.Run("oauth state", func(t *testing.T) {
+		response := secondary(http.MethodPost, "https://shop.example.net/api/oauth/state",
+			`{"provider":"oidc","intent":"login"}`, GenerateOAuthCode)
+		assert.Equal(t, http.StatusOK, response.Code)
+		assert.NotContains(t, response.Body.String(), "PRIMARY_ORIGIN")
+		assert.NotContains(t, response.Body.String(), "panel.example.com")
+		assert.Contains(t, response.Body.String(), `"success":false`)
+	})
+
+	t.Run("provider callback", func(t *testing.T) {
+		response := secondary(http.MethodGet, "https://shop.example.net/api/oauth/oidc",
+			"", HandleOAuth)
+		assert.Equal(t, http.StatusBadRequest, response.Code)
+		assert.Contains(t, response.Body.String(), "Unknown OAuth provider")
+		assert.NotContains(t, response.Body.String(), "PRIMARY_ORIGIN")
+	})
+
+	t.Run("wechat", func(t *testing.T) {
+		common.WeChatAuthEnabled = true
+		response := secondary(http.MethodGet, "https://shop.example.net/api/oauth/wechat",
+			"", WeChatAuth)
+		assert.Equal(t, http.StatusOK, response.Code)
+		assert.Contains(t, response.Body.String(), "has not been enabled by administrator")
+		assert.NotContains(t, response.Body.String(), "PRIMARY_ORIGIN")
+	})
+
+	t.Run("passkey login", func(t *testing.T) {
+		response := secondary(http.MethodPost, "https://shop.example.net/api/user/passkey/login/begin",
+			`{}`, PasskeyLoginBegin)
+		assert.Equal(t, http.StatusOK, response.Code)
+		assert.Contains(t, response.Body.String(), "Passkey authentication is disabled")
+		assert.NotContains(t, response.Body.String(), "PRIMARY_ORIGIN")
+	})
+
+	// The primary address keeps the provider: the request reaches the stock
+	// state check instead of being answered as an unknown provider.
+	t.Run("primary keeps provider", func(t *testing.T) {
+		response := secondary(http.MethodGet, "https://panel.example.com/api/oauth/oidc", "", HandleOAuth)
+		require.Equal(t, http.StatusForbidden, response.Code)
+		assert.Contains(t, response.Body.String(), "State parameter is empty or mismatched")
+		assert.NotContains(t, response.Body.String(), "Unknown OAuth provider")
+	})
+}
