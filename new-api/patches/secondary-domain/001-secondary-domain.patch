+func TestRedirectBaseMatchesBrowserOrigin(t *testing.T) {
+	previousAddress := system_setting.ServerAddress
+	t.Cleanup(func() { system_setting.ServerAddress = previousAddress })
+
+	for _, address := range []string{
+		"https://panel.example.com",
+		"https://panel.example.com/",
+		"https://panel.example.com/newapi",
+		"https://PANEL.example.com:443",
+	} {
+		system_setting.ServerAddress = address
+		assert.Equal(t, "https://panel.example.com", redirectBase(), "address %q", address)
+	}
+
+	// Without a configured address there is no origin to derive; the raw value
+	// is kept so the identity provider reports the misconfiguration itself.
+	system_setting.ServerAddress = ""
+	assert.Equal(t, "", redirectBase())
+}
