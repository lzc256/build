-func paymentReturnPath(suffix string) string {
-	base := strings.TrimRight(system_setting.ServerAddress, "/")
-	return base + suffix
+// requestBaseURL returns the scheme://host[:port] the browser is currently
+// using, so redirects and links handed to that browser stay on the address it
+// opened. A single-address deployment is unaffected: the primary origin keeps
+// ServerAddress verbatim, which preserves a configured path prefix.
+// paymentCallbackBaseURL is the base for URLs the payment gateway uses to reach
+// this instance. They end up in the parameters the browser posts to the cashier,
+// so on a secondary domain they must name that domain and nothing else; on the
+// primary address an explicitly configured CustomCallbackAddress still wins, as
+// that is where the operator wants the gateway to call.
+func paymentCallbackBaseURL(c *gin.Context) string {
+	if !isSecondaryDomainRequest(c) {
+		if custom := strings.TrimRight(strings.TrimSpace(operation_setting.CustomCallbackAddress), "/"); custom != "" {
+			return custom
+		}
+	}
+	return requestBaseURL(c)
+}
+
+func requestBaseURL(c *gin.Context) string {
+	configured := strings.TrimRight(strings.TrimSpace(system_setting.ServerAddress), "/")
+	origin, ok := common.RequestPublicOrigin(c.Request)
+	if !ok {
+		return configured
+	}
+	if primary, ok := system_setting.PrimaryOrigin(); ok && strings.EqualFold(origin, primary) {
+		return configured
+	}
+	return origin
 }
