diff --git a/setting/system_setting/primary_origin.go b/setting/system_setting/primary_origin.go
new file mode 100644
index 00000000..f3393cd7
--- /dev/null
+++ b/setting/system_setting/primary_origin.go
@@ -0,0 +1,42 @@
+package system_setting
+
+import (
+	"net/http"
+	"net/url"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+// PrimaryOrigin returns the normalized origin of ServerAddress, the canonical
+// address of this site. ServerAddress may carry a path prefix (an upstream
+// proxy mount point); the path is dropped because a browser origin never has
+// one.
+func PrimaryOrigin() (string, bool) {
+	parsed, err := url.Parse(strings.TrimSpace(ServerAddress))
+	if err != nil || parsed.Host == "" {
+		return "", false
+	}
+	origin, err := common.NormalizeOrigin(parsed.Scheme + "://" + parsed.Host)
+	return origin, err == nil
+}
+
+// IsPrimaryRequest reports whether a browser request arrived on ServerAddress.
+// Every other host is a secondary entry point: it must not advertise the
+// primary address, the identity provider or any third-party sign-in provider,
+// so a visitor of a secondary domain never learns that the primary one exists.
+//
+// Without a usable ServerAddress the historical single-address behaviour is
+// kept and every request counts as primary, which also keeps first-run setup
+// working.
+func IsPrimaryRequest(request *http.Request) bool {
+	primary, ok := PrimaryOrigin()
+	if !ok {
+		return true
+	}
+	origin, ok := common.RequestPublicOrigin(request)
+	if !ok {
+		return false
+	}
+	return strings.EqualFold(origin, primary)
+}
diff --git a/setting/system_setting/primary_origin_test.go b/setting/system_setting/primary_origin_test.go
new file mode 100644
index 00000000..21c0a858
--- /dev/null
+++ b/setting/system_setting/primary_origin_test.go
@@ -0,0 +1,64 @@
+package system_setting
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func withServerAddress(t *testing.T, value string) {
+	t.Helper()
+	previous := ServerAddress
+	ServerAddress = value
+	t.Cleanup(func() { ServerAddress = previous })
+}
+
+func TestPrimaryOrigin(t *testing.T) {
+	withServerAddress(t, "https://panel.example.com/")
+	origin, ok := PrimaryOrigin()
+	assert.True(t, ok)
+	assert.Equal(t, "https://panel.example.com", origin)
+
+	withServerAddress(t, "https://gateway.example.com/newapi")
+	origin, ok = PrimaryOrigin()
+	assert.True(t, ok)
+	assert.Equal(t, "https://gateway.example.com", origin)
+
+	withServerAddress(t, "")
+	_, ok = PrimaryOrigin()
+	assert.False(t, ok)
+
+	withServerAddress(t, "panel.example.com")
+	_, ok = PrimaryOrigin()
+	assert.False(t, ok)
+}
+
+func TestIsPrimaryRequest(t *testing.T) {
+	withServerAddress(t, "https://panel.example.com")
+
+	primary := httptest.NewRequest("GET", "https://panel.example.com/api/status", nil)
+	assert.True(t, IsPrimaryRequest(primary))
+
+	secondary := httptest.NewRequest("GET", "https://shop.example.net/api/status", nil)
+	assert.False(t, IsPrimaryRequest(secondary))
+
+	// A secondary domain hidden behind a proxy still identifies itself through
+	// the forwarded host, so it must stay secondary.
+	forwarded := httptest.NewRequest("GET", "http://127.0.0.1:3000/api/status", nil)
+	forwarded.Header.Set("X-Forwarded-Proto", "https")
+	forwarded.Header.Set("X-Forwarded-Host", "shop.example.net")
+	assert.False(t, IsPrimaryRequest(forwarded))
+
+	forwardedPrimary := httptest.NewRequest("GET", "http://127.0.0.1:3000/api/status", nil)
+	forwardedPrimary.Header.Set("X-Forwarded-Proto", "https")
+	forwardedPrimary.Header.Set("X-Forwarded-Host", "panel.example.com")
+	assert.True(t, IsPrimaryRequest(forwardedPrimary))
+}
+
+func TestIsPrimaryRequestWithoutServerAddressKeepsSingleAddressBehaviour(t *testing.T) {
+	withServerAddress(t, "")
+
+	request := httptest.NewRequest("GET", "https://anything.example.org/api/status", nil)
+	assert.True(t, IsPrimaryRequest(request))
+}
