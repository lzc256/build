+package controller
+
+import (
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/oauth"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/stretchr/testify/require"
+)
+
+func TestLinkedOAuthStepUpAlongsideExistingCredentials(t *testing.T) {
+	for _, credential := range []string{"password", "password disabled", "passkey", "2fa"} {
+		t.Run(credential, func(t *testing.T) {
+			user, identity := setupSecurityEnrollmentTest(t)
+			require.NoError(t, model.DB.Model(user).Updates(map[string]any{"github_id": "linked-user", "role": common.RoleRootUser}).Error)
+			require.NoError(t, model.PublishUserAuthCache(user.Id))
+			if credential == "passkey" {
+				newSecurityLoginPasskey(t, user.Id)
+			}
+			if credential == "2fa" {
+				require.NoError(t, model.DB.Create(&model.TwoFA{UserId: user.Id, Secret: "JBSWY3DPEHPK3PXP", IsEnabled: true}).Error)
+			}
+			if credential == "password disabled" {
+				previous := common.PasswordLoginEnabled
+				common.PasswordLoginEnabled = false
+				t.Cleanup(func() { common.PasswordLoginEnabled = previous })
+			}
+			provider := &enrollmentOAuthProvider{externalID: "linked-user"}
+			oauth.Register("step-up-oauth", provider)
+			t.Cleanup(func() { oauth.Unregister("step-up-oauth") })
+			for _, operation := range []service.VerificationOperation{
+				{Scope: service.VerificationScopePasskeyRegister},
+				{Scope: service.VerificationScopeChannelKeyRead, Context: []byte(`{"channel_id":1}`)},
+				{Scope: service.VerificationScopeAdminUserManage, Context: []byte(`{"user_id":2,"action":"disable"}`)},
+			} {
+				requirements, err := service.RequireVerificationMethod(identity, operation.Scope, service.VerificationMethodOAuth)
+				require.NoError(t, err)
+				require.NotEmpty(t, requirements.OAuthProviders)
+				if credential != "password disabled" && (credential != "password" || operation.Scope != service.VerificationScopeChannelKeyRead) {
+					_, err = service.RequireVerificationMethod(identity, operation.Scope, credential)
+					require.NoError(t, err)
+				}
+				flow, err := service.StartOAuthVerification(identity, operation, "step-up-oauth")
+				require.NoError(t, err)
+				_, err = service.FinishOAuthVerification(identity, "step-up-oauth", "wrong-user", flow)
+				require.ErrorIs(t, err, service.ErrOAuthAccountMismatch)
+				proof, err := service.FinishOAuthVerification(identity, "step-up-oauth", "linked-user", flow)
+				require.NoError(t, err)
+				_, err = service.ConsumeOperationProof(proof.ProofToken, identity, operation)
+				require.NoError(t, err)
+				_, err = service.ConsumeOperationProof(proof.ProofToken, identity, operation)
+				require.ErrorIs(t, err, service.ErrProofConsumed)
+			}
+			// Binding/provider availability is checked again before issuing a proof.
+			flow, err := service.StartOAuthVerification(identity, service.VerificationOperation{Scope: service.VerificationScopePasskeyRegister}, "step-up-oauth")
+			require.NoError(t, err)
+			provider.disabled = true
+			_, err = service.FinishOAuthVerification(identity, "step-up-oauth", "linked-user", flow)
+			require.Error(t, err)
+			// Login still requires its original second factor, not an OAuth substitute.
+			_, err = service.GetVerificationRequirements(identity, service.VerificationScopeLogin)
+			require.ErrorIs(t, err, service.ErrProofScope)
+		})
+	}
+}
+
+func TestLinkedOAuthStepUpOmitsUnavailableAlternative(t *testing.T) {
+	_, identity := setupSecurityEnrollmentTest(t)
+	requirements, err := service.GetVerificationRequirements(identity, service.VerificationScopePasskeyRegister)
+	require.NoError(t, err)
+	require.Len(t, requirements.Methods, 1)
+	require.Equal(t, service.VerificationMethodPassword, requirements.Methods[0].Method)
+}
