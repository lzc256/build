+package worker
+
+import (
+	"os"
+	"strings"
+	"sync"
+
+	"github.com/nkanaev/yarr/src/storage/model"
+)
+
+var (
+	filterTitleOnce     sync.Once
+	filterTitleValues   []string
+	filterContentOnce   sync.Once
+	filterContentValues []string
+)
+
+// GetFilterTitle returns title filter keywords from YARR_FILTER_TITLE env
+func GetFilterTitle() []string {
+	filterTitleOnce.Do(func() {
+		if v := os.Getenv("YARR_FILTER_TITLE"); v != "" {
+			for _, s := range strings.Split(v, ",") {
+				if trimmed := strings.TrimSpace(s); trimmed != "" {
+					filterTitleValues = append(filterTitleValues, trimmed)
+				}
+			}
+		}
+	})
+	return filterTitleValues
+}
+
+// GetFilterContent returns content filter keywords from YARR_FILTER_CONTENT env
+func GetFilterContent() []string {
+	filterContentOnce.Do(func() {
+		if v := os.Getenv("YARR_FILTER_CONTENT"); v != "" {
+			for _, s := range strings.Split(v, ",") {
+				if trimmed := strings.TrimSpace(s); trimmed != "" {
+					filterContentValues = append(filterContentValues, trimmed)
+				}
+			}
+		}
+	})
+	return filterContentValues
+}
+
+// FilterItems filters out items matching title/content keywords.
+// Returns the filtered slice (may be shorter than input).
+func FilterItems(items []model.Item) []model.Item {
+	titleKw := GetFilterTitle()
+	contentKw := GetFilterContent()
+	if len(titleKw) == 0 && len(contentKw) == 0 {
+		return items
+	}
+
+	filtered := items[:0]
+	for _, item := range items {
+		discard := false
+		for _, kw := range titleKw {
+			if strings.Contains(item.Title, kw) {
+				discard = true
+				break
+			}
+		}
+		if !discard {
+			for _, kw := range contentKw {
+				if strings.Contains(item.Content, kw) {
+					discard = true
+					break
+				}
+			}
+		}
+		if !discard {
+			filtered = append(filtered, item)
+		}
+	}
+	return filtered
+}
