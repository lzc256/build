--- a/create_variant_resources.sh
+++ b/create_variant_resources.sh
@@ -17,7 +17,7 @@ for build_flavor in "${flavors[@]}"; do
 
 <!-- File generated by $0 -->
 <resources>
-    <string name="login_redirect_scheme" translatable="false">chat.schildi.android.$build_flavor.$build_type</string>
