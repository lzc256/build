From 81415604dd42869bd20330732e0042e1dbfab7aa Mon Sep 17 00:00:00 2001
From: lzc256 <i@lzc256.com>
Date: Sun, 8 Nov 2026 23:26:13 +0800
Subject: [PATCH] build: use the chat.schildi.android.mod application id

Lets this build be installed next to the official SchildiChat Next instead of
replacing it: a different application id means a different package, so the data
directories, the  based provider authorities and the OIDC
redirect scheme (which would otherwise make Android ask which app should handle
the login redirect) are all distinct.
---
 app/build.gradle.kts                                   | 8 ++++----
 app/src/fdroidScBetaDebug/res/values/variant.xml       | 2 +-
 app/src/fdroidScBetaRelease/res/values/variant.xml     | 2 +-
 app/src/fdroidScDefaultDebug/res/values/variant.xml    | 2 +-
 app/src/fdroidScDefaultRelease/res/values/variant.xml  | 2 +-
 app/src/fdroidScInternalDebug/res/values/variant.xml   | 2 +-
 app/src/fdroidScInternalRelease/res/values/variant.xml | 2 +-
 create_variant_resources.sh                            | 2 +-
 8 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index eaac9d0d20..dce5beb91a 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -44,7 +44,7 @@ android {
 
     defaultConfig {
         //applicationId = BuildTimeConfig.APPLICATION_ID
-        applicationId = "chat.schildi.android"
+        applicationId = "chat.schildi.android.mod"
         versionCode = 1260
         versionName = "0.11.8-ex_26_10_1"
         targetSdk = Versions.TARGET_SDK
@@ -240,20 +240,20 @@ android {
         // SC variants for different release tracks. Cannot do actual release types for those since fdroid build tools always want `release` builds.
         create("default") {
             dimension = "sc-variant"
-            applicationId = "chat.schildi.android"
+            applicationId = "chat.schildi.android.mod"
             isDefault = true
             resValue("string", "sc_app_name", "SchildiChat Next")
             resValue("string", "sc_app_name_launcher", "SchildiNext")
         }
         create("beta") {
             dimension = "sc-variant"
-            applicationId = "chat.schildi.next"
+            applicationId = "chat.schildi.android.mod.beta"
             resValue("string", "sc_app_name", "SchildiChat Next (Beta)")
             resValue("string", "sc_app_name_launcher", "SchildiNext β")
         }
         create("internal") {
             dimension = "sc-variant"
-            applicationId = "chat.schildi.next.internal"
+            applicationId = "chat.schildi.android.mod.internal"
             resValue("string", "sc_app_name", "SchildiChat Next (Internal)")
             resValue("string", "sc_app_name_launcher", "SchildiNext[i]")
         }
diff --git a/app/src/fdroidScBetaDebug/res/values/variant.xml b/app/src/fdroidScBetaDebug/res/values/variant.xml
index 16b56abb51..2d7a5e8cbd 100644
--- a/app/src/fdroidScBetaDebug/res/values/variant.xml
+++ b/app/src/fdroidScBetaDebug/res/values/variant.xml
@@ -2,5 +2,5 @@
 
 <!-- File generated by ./create_variant_resources.sh -->
 <resources>
-    <string name="login_redirect_scheme" translatable="false">chat.schildi.android.beta.debug</string>
+    <string name="login_redirect_scheme" translatable="false">chat.schildi.android.mod.beta.debug</string>
 </resources>
