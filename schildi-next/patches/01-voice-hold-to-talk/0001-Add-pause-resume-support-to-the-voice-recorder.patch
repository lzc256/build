@@ -62,6 +63,13 @@ class DefaultVoiceRecorder(
     private var outputFile: File? = null
     private var audioReader: AudioReader? = null
     private var recordingJob: Job? = null
+    // Total time recorded in the previous segments of the current session
+    private var accumulatedDuration: Duration = Duration.ZERO
+    private var segmentStartedAt: TimeMark? = null
+
+    // Total time recorded so far, excluding the time spent paused
+    private val totalRecordedTime: Duration
+        get() = accumulatedDuration + (segmentStartedAt?.elapsedNow() ?: Duration.ZERO)
 
     // List of Float between 0 and 1 representing the audio levels
     private val levels: MutableList<Float> = mutableListOf()
@@ -82,17 +90,65 @@ class DefaultVoiceRecorder(
             .also(encoder::init)
 
         levels.clear()
+        accumulatedDuration = Duration.ZERO
+
+        startCapture()
+    }
+
+    @RequiresPermission(Manifest.permission.RECORD_AUDIO)
+    override suspend fun resumeRecord() = lock.withLock {
+        if (recordingJob != null || outputFile == null) {
+            Timber.w("Voice recorder has no paused recording, ignoring this resume")
+            return@withLock
+        }
+
+        Timber.i("Voice recorder resumed recording")
+        startCapture()
+    }
+
+    override suspend fun pauseRecord() {
+        val wasRecording = recordingJob != null
+        recordingJob?.cancel()
+        recordingJob = null
+        audioReader?.stop()
+        audioReader = null
+
+        lock.withLock {
+            val file = outputFile
+            if (!wasRecording || file == null) {
+                return@withLock
+            }
+
+            Timber.i("Voice recorder paused recording")
+            accumulatedDuration += segmentStartedAt?.elapsedNow() ?: Duration.ZERO
+            segmentStartedAt = null
+
+            _state.emit(
+                VoiceRecorderState.Paused(
+                    file = file,
+                    elapsedTime = accumulatedDuration,
+                    waveform = levels.resample(100),
+                )
+            )
+        }
+    }
 
+    /**
+     * Capture audio into the current encoder session, appending to whatever was recorded before.
+     *
+     * Must be called with [lock] held.
+     */
+    private fun startCapture() {
+        segmentStartedAt = timeSource.markNow()
         val audioRecorder = audioReaderFactory.create(config, dispatchers).also { audioReader = it }
 
         recordingJob = voiceCoroutineScope.launch {
-            val startedAt = timeSource.markNow()
             audioRecorder.record { audio ->
                 yield()
 
-                val elapsedTime = startedAt.elapsedNow()
+                val recordedTime = totalRecordedTime
 
-                if (elapsedTime > VoiceMessageConfig.maxVoiceMessageDuration) {
+                if (recordedTime > VoiceMessageConfig.maxVoiceMessageDuration) {
                     Timber.w("Voice message time limit reached")
                     stopRecord(false)
                     return@record
