         val levels: List<Float>,
     ) : VoiceRecorderState
 
+    /**
+     * The recorder is paused: the session is still alive and can be resumed with
+     * [VoiceRecorder.resumeRecord].
+     *
+     * @property file The file the recording is written to. It is not finalized yet.
+     * @property elapsedTime The total time spent recording so far, excluding the paused time.
+     * @property waveform The waveform of the recording so far. All values are between 0 and 1.
+     */
+    data class Paused(
+        val file: File,
+        val elapsedTime: Duration,
+        val waveform: List<Float>,
+    ) : VoiceRecorderState
     /**
      * The recorder has finished recording.
