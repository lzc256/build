index 3427f694b3..ed236bc9dc 100644
--- a/libraries/voicerecorder/api/src/main/kotlin/io/element/android/libraries/voicerecorder/api/VoiceRecorder.kt
+++ b/libraries/voicerecorder/api/src/main/kotlin/io/element/android/libraries/voicerecorder/api/VoiceRecorder.kt
@@ -24,6 +24,22 @@ interface VoiceRecorder {
     @RequiresPermission(Manifest.permission.RECORD_AUDIO)
     suspend fun startRecord()
 
+    /**
+     * Pause the current recording, keeping the recording session alive.
+     *
+     * The microphone is released while paused, so no audio is captured. Call [resumeRecord] to
+     * continue the same recording, or [stopRecord] to finalize it.
+     */
+    suspend fun pauseRecord()
+
+    /**
+     * Resume a recording which was paused with [pauseRecord].
+     *
+     * The audio is appended to the same file, and the elapsed time of the previous segments is kept.
+     */
+    @RequiresPermission(Manifest.permission.RECORD_AUDIO)
+    suspend fun resumeRecord()
+
     /**
      * Stop the current recording.
      *
diff --git a/libraries/voicerecorder/api/src/main/kotlin/io/element/android/libraries/voicerecorder/api/VoiceRecorderState.kt b/libraries/voicerecorder/api/src/main/kotlin/io/element/android/libraries/voicerecorder/api/VoiceRecorderState.kt
