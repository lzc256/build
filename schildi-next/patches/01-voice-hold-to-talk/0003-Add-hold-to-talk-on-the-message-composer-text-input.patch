+import io.element.android.libraries.designsystem.theme.components.Icon
+import io.element.android.libraries.designsystem.theme.components.Text
+import kotlin.time.Duration
+import kotlin.time.Duration.Companion.seconds
+import kotlin.time.TimeMark
+import kotlin.time.TimeSource
+
+// SC: distance to slide up before the recording gets cancelled
+private val VoiceHoldCancelThreshold = 60.dp
+
+// SC: recordings shorter than this are considered as an accidental long press
+private val MinVoiceHoldDuration = 1.seconds
+
+/**
+ * SC: transparent overlay drawn on top of the message composer text input, implementing the
+ * "hold to talk" gesture for an empty composer: a long press starts a voice message recording, an
+ * upward slide cancels it, and releasing the finger sends it right away.
+ *
+ * A short press focuses the text input as usual, so the overlay is only ever used when the text
+ * input is empty: as soon as some text is typed the overlay is removed and the text input behaves
+ * natively again.
+ */
+@Composable
+internal fun VoiceHoldGestureOverlay(
+    canStartRecording: Boolean,
+    canRecordAudio: () -> Boolean,
+    onTap: () -> Unit,
+    onStartRecording: () -> Unit,
+    onSendVoiceMessage: () -> Unit,
+    onCancelRecording: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val context = LocalContext.current
+    val hapticFeedback = LocalHapticFeedback.current
+    val density = LocalDensity.current
+    val cancelThresholdPx = with(density) { VoiceHoldCancelThreshold.toPx() }
+
+    // The callbacks are read through a gesture which outlives recompositions
+    val currentCanStartRecording by rememberUpdatedState(canStartRecording)
+    val currentCanRecordAudio by rememberUpdatedState(canRecordAudio)
+    val currentOnTap by rememberUpdatedState(onTap)
+    val currentOnStartRecording by rememberUpdatedState(onStartRecording)
+    val currentOnSendVoiceMessage by rememberUpdatedState(onSendVoiceMessage)
+    val currentOnCancelRecording by rememberUpdatedState(onCancelRecording)
+
+    // Shared between the two pointer input modifiers below, which both see the same gesture
+    val gestureState = remember { HoldToTalkGestureState() }
+    var isCancelPending by remember { mutableStateOf(false) }
+
+    fun resetGesture() {
+        gestureState.isRecording = false
+        gestureState.startedAt = null
+        isCancelPending = false
+    }
+
+    Box(
+        modifier = modifier
+            // Observes the whole gesture, without ever consuming it: the long press delay is
+            // handled by combinedClickable below
+            .pointerInput(Unit) {
+                awaitEachGesture {
+                    val down = awaitFirstDown(requireUnconsumed = false)
+                    var cancelPending = false
+                    try {
+                        while (true) {
+                            val event = awaitPointerEvent()
+                            if (event.changes.none { it.pressed }) break
+                            if (gestureState.isRecording) {
+                                val change = event.changes.firstOrNull { it.id == down.id } ?: break
+                                val pending = change.position.y - down.position.y < -cancelThresholdPx
+                                if (pending != cancelPending) {
+                                    cancelPending = pending
+                                    isCancelPending = pending
+                                    hapticFeedback.performHapticFeedback(HapticFeedbackType.LongPress)
+                                }
+                            }
+                        }
+                        if (gestureState.isRecording) {
+                            val duration = gestureState.startedAt?.elapsedNow() ?: Duration.ZERO
+                            resetGesture()
+                            when {
+                                cancelPending -> currentOnCancelRecording()
+                                duration < MinVoiceHoldDuration -> {
+                                    currentOnCancelRecording()
+                                    context.toast(chat.schildi.lib.R.string.sc_voice_too_short)
+                                }
+                                else -> currentOnSendVoiceMessage()
+                            }
+                        }
+                    } finally {
+                        // The gesture was interrupted (pointer cancelled), do not keep recording
+                        if (gestureState.isRecording) {
+                            resetGesture()
+                            currentOnCancelRecording()
+                        }
+                    }
+                }
+            }
+            .combinedClickable(
+                interactionSource = remember { MutableInteractionSource() },
+                indication = null,
+                onLongClick = {
+                    if (currentCanStartRecording && currentCanRecordAudio()) {
+                        gestureState.isRecording = true
+                        gestureState.startedAt = TimeSource.Monotonic.markNow()
+                        hapticFeedback.performHapticFeedback(HapticFeedbackType.LongPress)
+                        currentOnStartRecording()
+                    } else {
+                        // Without the permission we cannot record: fall back to a regular tap
+                        currentOnTap()
+                    }
+                },
+                onClick = { currentOnTap() },
+            ),
+    ) {
+        if (isCancelPending) {
+            Row(
+                modifier = Modifier
+                    .align(Alignment.TopCenter)
+                    .padding(top = 4.dp)
+                    .background(
+                        color = ElementTheme.colors.bgCriticalPrimary,
+                        shape = RoundedCornerShape(4.dp),
+                    )
+                    .padding(horizontal = 8.dp, vertical = 2.dp),
+                horizontalArrangement = Arrangement.spacedBy(4.dp),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                Icon(
+                    modifier = Modifier.size(16.dp),
+                    imageVector = CompoundIcons.ChevronUp(),
+                    contentDescription = null,
+                    tint = ElementTheme.colors.iconOnSolidPrimary,
+                )
+                Text(
+                    text = stringResource(chat.schildi.lib.R.string.sc_voice_release_to_cancel),
+                    style = ElementTheme.typography.fontBodyXsMedium,
+                    color = ElementTheme.colors.iconOnSolidPrimary,
+                )
+            }
+        }
+    }
+}
+
+private class HoldToTalkGestureState {
+    var isRecording: Boolean = false
+    var startedAt: TimeMark? = null
+}
