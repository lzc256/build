+    /**
+     * Stop the recording if it is still alive and return the finalized recording, ready to be sent.
+     */
+    private suspend fun finalizeRecording(): VoiceRecorderState.Finished? {
+        when (voiceRecorder.state.value) {
+            is VoiceRecorderState.Recording, is VoiceRecorderState.Paused -> {
+                voiceRecorder.stopRecord()
+                audioFocus.releaseAudioFocus()
+            }
+            else -> Unit
+        }
+        val state = voiceRecorder.state.first { it is VoiceRecorderState.Finished || it is VoiceRecorderState.Idle }
+        return state as? VoiceRecorderState.Finished
+    }
+
